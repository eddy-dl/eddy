import { AppSettings } from "../../globals/AppSettings.slint";
import { DownloadOptionsEditor } from "../../components/DownloadOptionsEditor.slint";
import { Chip, SectionLabel } from "../../components/Chips.slint";
import { Note } from "../../components/Note.slint";

// Settings → Downloads → Downloading: every download's defaults (a
// download's preview or options sheet can change them for it).
export component DownloadingSettings inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;

    // Takes the focus off a text field tapped away from (so the keyboard
    // goes and Back works on the sheet again).
    park := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    TouchArea {
        clicked => { park.focus(); }
    }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-height: downloading_layout.preferred-height;

        // Taps between the rows.
        TouchArea {
            height: downloading_layout.preferred-height;
            clicked => { park.focus(); }
        }

        downloading_layout := VerticalLayout {
            alignment: start;
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 8px;
            padding-bottom: 24px;
            spacing: 10px;

            // All downloads together, so not in the editor (which a single
            // download's options use too).
            SectionLabel { text: @tr("Downloads at once"); }
            HorizontalLayout {
                spacing: 8px;
                for n in [1, 2, 3, 5, 0]: Chip {
                    text: n == 0 ? "∞" : n;
                    selected: AppSettings.dl_max_concurrent == n;
                    clicked => {
                        AppSettings.dl_max_concurrent = n;
                        AppSettings.preferences_changed();
                    }
                }
            }
            Note {
                text: AppSettings.dl_max_concurrent == 0
                    ? @tr("Every download starts straight away.")
                    : @tr("Others wait in Queued and start, oldest first, as these finish.");
                font_size: 13px;
                text_color: root.text_color;
            }

            SectionLabel { text: @tr("If a file already exists"); }
            HorizontalLayout {
                spacing: 8px;
                Chip {
                    text: @tr("Keep both");
                    selected: !AppSettings.dl_replace_existing;
                    clicked => {
                        AppSettings.dl_replace_existing = false;
                        AppSettings.preferences_changed();
                    }
                }
                Chip {
                    text: @tr("Replace");
                    selected: AppSettings.dl_replace_existing;
                    clicked => {
                        AppSettings.dl_replace_existing = true;
                        AppSettings.preferences_changed();
                    }
                }
            }
            Note {
                text: AppSettings.dl_replace_existing
                    ? @tr("The old one is replaced by the new download.")
                    : @tr("The new one gets a number: \"name (1)\".");
                font_size: 13px;
                text_color: root.text_color;
            }

            DownloadOptionsEditor {
                text_color: root.text_color;
                speed_kbps <=> AppSettings.dl_speed_kbps;
                connections <=> AppSettings.dl_connections;
                ua_mode <=> AppSettings.dl_ua_mode;
                ua_custom <=> AppSettings.dl_ua_custom;
                category <=> AppSettings.dl_category_folders;
                changed => { AppSettings.preferences_changed(); }
            }
        }
    }
}
