import { WrappedText } from "../../components/WrappedText.slint";
import { Note } from "../../components/Note.slint";
import { SwitchRow } from "../../components/SwitchRow.slint";
import { AppSettings } from "../../globals/AppSettings.slint";
import { ThemeSettings } from "../../themes/theme.slint";
import { SectionHeader, SettingsCard, SettingsLayout } from "../SettingsCard.slint";

// Settings → Advanced.
export component AdvancedSettings inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;

    private property <bool> can_clear: !AppSettings.cache_empty && !AppSettings.cache_busy && !AppSettings.downloads_running;

    TouchArea { }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-height: advanced_layout.preferred-height;

        advanced_layout := VerticalLayout {
            spacing: SettingsLayout.spacing;
            alignment: start;
            padding-left: SettingsLayout.side;
            padding-right: SettingsLayout.side;
            padding-top: 8px;
            // Room under the last item, so it doesn't end at the edge.
            padding-bottom: 24px;

            // Clear download cache: files Eddy can make again.
            SettingsCard {
                first: true;
                last: true;

                HorizontalLayout {
                    padding: 8px;
                    // Room for a subtitle that wraps (MD3: 12 for three lines;
                    // the card's 72 minimum keeps shorter rows as they were).
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Download cache");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        WrappedText {
                            text: AppSettings.is_mobile
                                ? @tr("Link previews' thumbnails and info, downloaded installers, temporary files.")
                                : @tr("Link previews' thumbnails and info, temporary files.");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                        }
                        WrappedText {
                            text: AppSettings.cache_busy ? @tr("Clearing…")
                                : AppSettings.cache_size == "" ? @tr("Measuring…")
                                : AppSettings.downloads_running ? @tr("{} · can be cleared once downloads finish", AppSettings.cache_size)
                                : AppSettings.cache_size;
                            font-size: 13px;
                            color: ThemeSettings.primary_accent.transparentize(30%);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: clear_label.preferred-width + 24px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.can_clear ? ThemeSettings.primary_accent : root.text_color.transparentize(85%);
                            clear_label := Text {
                                text: @tr("Clear");
                                font-size: 13px;
                                font-weight: 600;
                                color: root.can_clear ? #ffffff : root.text_color.transparentize(50%);
                                vertical-alignment: center;
                            }
                            TouchArea {
                                enabled: root.can_clear;
                                clicked => { AppSettings.cache_clear(); }
                            }
                        }
                    }
                }
            }

            // Lined up with the card's text.
            VerticalLayout {
                padding-left: SettingsLayout.inset;
                padding-right: SettingsLayout.inset;
                padding-top: 8px;
                Note {
                    text: @tr("Your downloaded files are not deleted.");
                    text_color: root.text_color;
                }
            }

            // For looking into problems.
            SectionHeader { text: @tr("Debug"); }

            SwitchRow {
                first: true;
                last: false;
                title: @tr("Show resource usage");
                subtitle: @tr("Eddy's memory and CPU use, at the top of the screen.");
                text_color: root.text_color;
                checked <=> AppSettings.show_usage;
                toggled => { AppSettings.preferences_changed(); }
            }

            // Logs: private unless asked (they hold links and file names).
            SwitchRow {
                first: false;
                last: false;
                title: @tr("Save logs to Downloads");
                subtitle: @tr("In Download/Eddy/logs, where other apps can read them. They list the links you download.");
                text_color: root.text_color;
                checked <=> AppSettings.logs_in_downloads;
                toggled => { AppSettings.preferences_changed(); }
            }

            SettingsCard {
                first: false;
                last: true;

                HorizontalLayout {
                    padding: 8px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Logs");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        WrappedText {
                            text: @tr("What went wrong with downloads and link checks, to send with a bug report.");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: share_label.preferred-width + 24px;
                            height: 32px;
                            border-radius: 16px;
                            background: ThemeSettings.primary_accent;
                            share_label := Text {
                                text: @tr("Share");
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { AppSettings.share_logs(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
