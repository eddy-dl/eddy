import { ModernSwitch } from "../../components/Buttons.slint";
import { AppSettings } from "../../globals/AppSettings.slint";
import { ThemeSettings } from "../../themes/theme.slint";
import { SettingsCard, SettingsLayout } from "../SettingsCard.slint";

export component DownloadSettings inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;

    // Opens the yt-dlp packages page.
    callback open_packages();
    // Opens the Books page.
    callback open_books();
    // Opens the Downloading page (every download's defaults).
    callback open_downloading();
    // Opens the Cookies page.
    callback open_cookies();

    TouchArea { }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-height: dl_layout.preferred-height;

        dl_layout := VerticalLayout {
            spacing: SettingsLayout.spacing;
            alignment: start;
            padding-left: SettingsLayout.side;
            padding-right: SettingsLayout.side;
            padding-top: 8px;
            // Room under the last item, so it doesn't end at the edge.
            padding-bottom: 24px;

            // Full-row clickable download location setting
            SettingsCard {
                first: true;
                last: false;
                highlighted: dl_row_ta.has-hover;

                dl_row_ta := TouchArea {
                    clicked => {
                        AppSettings.select_download_folder();
                    }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    alignment: space-between;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Download Location");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: AppSettings.current_download_path != "" ? AppSettings.current_download_path : AppSettings.default_download_path;
                            font-size: 13px;
                            color: ThemeSettings.primary_accent.transparentize(30%);
                            overflow: elide;
                        }
                    }
                }
            }

            // Android only. The switch shows whether access is granted; the
            // row opens Android's screen to grant (or take back) it.
            if AppSettings.is_mobile: SettingsCard {
                first: false;
                last: false;
                highlighted: access_ta.has-hover;

                access_ta := TouchArea {
                    clicked => { AppSettings.request_all_files_access(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("All files access");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: AppSettings.all_files_access
                                ? @tr("Downloads go straight into any folder you pick.")
                                : @tr("Lets downloads go straight into any folder. Without it, folders outside Download and Documents get the files copied in once they finish.");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: switch.width;
                            height: switch.height;
                            switch := ModernSwitch {
                                checked: AppSettings.all_files_access;
                            }
                            // Over the switch, so it never flips by itself:
                            // it follows the permission.
                            TouchArea {
                                clicked => { AppSettings.request_all_files_access(); }
                            }
                        }
                    }
                }
            }

            // A cookies.txt for sites that need a login, pasted, edited or
            // picked on a page of its own.
            SettingsCard {
                first: false;
                last: true;
                highlighted: cookies_ta.has-hover;

                cookies_ta := TouchArea {
                    clicked => { root.open_cookies(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/cookie.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Cookies");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: AppSettings.cookies_error == 1 ? @tr("Couldn't read that file")
                                : AppSettings.cookies_error == 2 ? @tr("No cookies in that: paste a cookies.txt or a cookie extension's JSON export")
                                : AppSettings.cookies_error == 3 ? @tr("Couldn't save the cookies")
                                : AppSettings.cookies_count == 0 ? @tr("Paste or pick a cookies.txt from your browser, for sites that need you logged in.")
                                : @tr("{n} cookie" | "{n} cookies" % AppSettings.cookies_count) + " · " + AppSettings.cookies_sites;
                            font-size: 13px;
                            color: AppSettings.cookies_error != 0 ? #e5534b
                                : AppSettings.cookies_count > 0 ? ThemeSettings.primary_accent.transparentize(30%)
                                : root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }

            // Between the groups.
            Rectangle { height: SettingsLayout.group_gap; }

            // Every download's defaults, on a page of their own.
            SettingsCard {
                first: true;
                last: false;
                highlighted: downloading_ta.has-hover;

                downloading_ta := TouchArea {
                    clicked => { root.open_downloading(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/speed.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Downloading");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: @tr("Default download settings");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }

            // How web novels are saved, on a page of their own.
            SettingsCard {
                first: false;
                last: AppSettings.helper_packages.length == 0;
                highlighted: books_ta.has-hover;

                books_ta := TouchArea {
                    clicked => { root.open_books(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/menu_book.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Books");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: @tr("Web novel download options");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }

            // yt-dlp and friends, on a page of their own.
            if AppSettings.helper_packages.length > 0: SettingsCard {
                first: false;
                last: true;
                highlighted: packages_ta.has-hover;

                packages_ta := TouchArea {
                    clicked => { root.open_packages(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/package.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: AppSettings.is_mobile ? @tr("yt-dlp packages") : @tr("Media tools");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: AppSettings.is_mobile ? @tr("Manage yt-dlp packages") : @tr("Manage media tools");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }
        }
    }
}
