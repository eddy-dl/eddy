import { ModernSwitch } from "../../components/Buttons.slint";
import { AppSettings } from "../../globals/AppSettings.slint";
import { ThemeSettings } from "../../themes/theme.slint";
import { DownloadOptionsEditor } from "../../components/DownloadOptionsEditor.slint";

export component DownloadSettings inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;

    // Opens the yt-dlp packages page.
    callback open_packages();
    // Opens the Books page.
    callback open_books();

    TouchArea { }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-height: dl_layout.preferred-height;

        dl_layout := VerticalLayout {
            spacing: 24px;
            alignment: start;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;

            // Full-row clickable download location setting
            Rectangle {
                border-radius: 8px;
                background: dl_row_ta.has-hover ? ThemeSettings.hover_color : transparent;

                dl_row_ta := TouchArea {
                    clicked => {
                        AppSettings.select_download_folder();
                    }
                }

                HorizontalLayout {
                    padding: 8px;
                    alignment: space-between;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Download Location");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: AppSettings.current_download_path != "" ? AppSettings.current_download_path : AppSettings.default_download_path;
                            font-size: 13px;
                            color: ThemeSettings.primary_accent.transparentize(30%);
                            overflow: elide;
                        }
                    }
                }
            }

            // Android only. The switch shows whether access is granted; the
            // row opens Android's screen to grant (or take back) it.
            if AppSettings.is_mobile: Rectangle {
                border-radius: 8px;
                background: access_ta.has-hover ? ThemeSettings.hover_color : transparent;

                access_ta := TouchArea {
                    clicked => { AppSettings.request_all_files_access(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("All files access");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: AppSettings.all_files_access
                                ? @tr("Downloads go straight into any folder you pick.")
                                : @tr("Lets downloads go straight into any folder. Without it, folders outside Download and Documents get the files copied in once they finish.");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: switch.width;
                            height: switch.height;
                            switch := ModernSwitch {
                                checked: AppSettings.all_files_access;
                            }
                            // Over the switch, so it never flips by itself:
                            // it follows the permission.
                            TouchArea {
                                clicked => { AppSettings.request_all_files_access(); }
                            }
                        }
                    }
                }
            }

            // Every download's defaults; each preview can change them.
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: @tr("Downloading");
                    font-size: 18px;
                    font-weight: 600;
                    color: root.text_color;
                }
                Text {
                    text: @tr("How downloads go about it, unless a download's preview says otherwise.");
                    font-size: 13px;
                    color: root.text_color.transparentize(40%);
                    wrap: word-wrap;
                }
                DownloadOptionsEditor {
                    text_color: root.text_color;
                    speed_kbps <=> AppSettings.dl_speed_kbps;
                    connections <=> AppSettings.dl_connections;
                    ua_mode <=> AppSettings.dl_ua_mode;
                    ua_custom <=> AppSettings.dl_ua_custom;
                    category <=> AppSettings.dl_category_folders;
                    changed => { AppSettings.preferences_changed(); }
                }
            }

            // A cookies.txt for sites that need a login. Tapping picks one
            // (replacing the old one); Remove forgets it.
            Rectangle {
                border-radius: 8px;
                background: cookies_ta.has-hover ? ThemeSettings.hover_color : transparent;

                cookies_ta := TouchArea {
                    clicked => { AppSettings.cookies_add(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/cookie.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Cookies");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: AppSettings.cookies_error == 1 ? @tr("Couldn't read that file")
                                : AppSettings.cookies_error == 2 ? @tr("That isn't a cookies.txt (Netscape format)")
                                : AppSettings.cookies_error == 3 ? @tr("Couldn't save the cookies")
                                : AppSettings.cookies_count == 0 ? @tr("Add a cookies.txt exported from your browser, for sites that need you logged in.")
                                : @tr("{n} cookie" | "{n} cookies" % AppSettings.cookies_count) + " · " + AppSettings.cookies_sites;
                            font-size: 13px;
                            color: AppSettings.cookies_error != 0 ? #e5534b
                                : AppSettings.cookies_count > 0 ? ThemeSettings.primary_accent.transparentize(30%)
                                : root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    if AppSettings.cookies_count > 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: remove_label.preferred-width + 24px;
                            height: 32px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: root.text_color.transparentize(60%);
                            background: remove_ta.has-hover ? ThemeSettings.hover_color : transparent;
                            remove_label := Text {
                                text: @tr("Remove");
                                font-size: 13px;
                                font-weight: 600;
                                color: root.text_color;
                                vertical-alignment: center;
                            }
                            remove_ta := TouchArea {
                                clicked => { AppSettings.cookies_remove(); }
                            }
                        }
                    }
                }
            }

            // How web novels are saved, on a page of their own.
            Rectangle {
                border-radius: 8px;
                background: books_ta.has-hover ? ThemeSettings.hover_color : transparent;

                books_ta := TouchArea {
                    clicked => { root.open_books(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/menu_book.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Books");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: @tr("Web novels saved as EPUB: author notes, images");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }

            // yt-dlp and friends, on a page of their own.
            if AppSettings.helper_packages.length > 0: Rectangle {
                border-radius: 8px;
                background: packages_ta.has-hover ? ThemeSettings.hover_color : transparent;

                packages_ta := TouchArea {
                    clicked => { root.open_packages(); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/package.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.text_color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: AppSettings.is_mobile ? @tr("yt-dlp packages") : @tr("Media tools");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }
                        Text {
                            text: AppSettings.is_mobile ? @tr("Python & yt-dlp, FFmpeg, Deno") : @tr("yt-dlp, FFmpeg, Deno");
                            font-size: 13px;
                            color: root.text_color.transparentize(40%);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../icons/arrow_right.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.text_color.transparentize(40%);
                        }
                    }
                }
            }
        }
    }
}
