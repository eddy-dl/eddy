import { ModernSwitch } from "../../components/Buttons.slint";
import { AppSettings } from "../../globals/AppSettings.slint";
import { ThemeSettings } from "../../themes/theme.slint";
import { AnimatedPopup } from "../../components/AnimatedPopup.slint";
import { RadioRow } from "../../components/RadioRow.slint";
import { SettingsCard, SettingsLayout } from "../SettingsCard.slint";

export component GeneralSettings inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;

    // Size of the whole window, so the popup's dimming covers all of it.
    in property <length> window_width;
    in property <length> window_height;

    // True while the language popup is showing.
    out property <bool> popup_open: false;
    private property <int> dismiss_requests: 0;

    // Back/Escape pressed inside the popup.
    callback popup_back_pressed();

    // Animates the popup out (for Back/Escape).
    public function dismiss_popup() {
        root.dismiss_requests += 1;
    }

    function set_language(language: string) {
        AppSettings.language = language;
        AppSettings.language_changed();
        AppSettings.preferences_changed();
    }

    TouchArea { }

    language_popup := PopupWindow {
        // Spans the whole window (popup coordinates are relative to this page).
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: root.window_width;
        height: root.window_height;
        // AnimatedPopup handles outside clicks so it can animate out first.
        close-policy: PopupClosePolicy.no-auto-close;

        AnimatedPopup {
            card_width: Math.min(320px, root.width - 40px);
            card_height: language_layout.preferred-height;
            dismiss_requests: root.dismiss_requests;
            back_pressed => { root.popup_back_pressed(); }
            closed => {
                language_popup.close();
                root.popup_open = false;
            }

            language_layout := VerticalLayout {
                padding: 20px;
                spacing: 8px;

                Text {
                    text: @tr("Language");
                    font-size: 18px;
                    font-weight: 700;
                    color: root.text_color;
                }

                RadioRow {
                    text: @tr("System Default");
                    active: AppSettings.language == "";
                    text_color: root.text_color;
                    clicked => { root.set_language(""); }
                }

                // Language names stay in their own language so they can be
                // found whatever the current UI language is.
                RadioRow {
                    text: "English";
                    active: AppSettings.language == "en";
                    text_color: root.text_color;
                    clicked => { root.set_language("en"); }
                }

                RadioRow {
                    text: "Français";
                    active: AppSettings.language == "fr";
                    text_color: root.text_color;
                    clicked => { root.set_language("fr"); }
                }
            }
        }
    }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-height: gen_layout.preferred-height;

        gen_layout := VerticalLayout {
            spacing: SettingsLayout.spacing;
            alignment: start;
            padding-left: SettingsLayout.side;
            padding-right: SettingsLayout.side;
            padding-top: 8px; // Increased padding-top for comfortable spacing below the top bar
            // Room under the last item, so it doesn't end at the edge.
            padding-bottom: 24px;

            SettingsCard {
                first: true;
                last: !AppSettings.is_mobile;
                highlighted: language_ta.has-hover;

                language_ta := TouchArea {
                    clicked => {
                        root.popup_open = true;
                        language_popup.show();
                    }
                }

                HorizontalLayout {
                    padding: 8px;
                    // Room for a subtitle that wraps (MD3: 12 for three lines;
                    // the card's 72 minimum keeps shorter rows as they were).
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    alignment: space-between;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Language");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: AppSettings.language == "fr" ? "Français"
                                : (AppSettings.language == "en" ? "English" : @tr("System Default"));
                            font-size: 13px;
                            color: ThemeSettings.primary_accent.transparentize(30%);
                        }
                    }
                }
            }

            if AppSettings.is_mobile: SettingsCard {
                first: false;
                last: true;
                highlighted: haptic_ta.has-hover;

                // The whole row toggles the switch, not just the switch itself.
                haptic_ta := TouchArea {
                    clicked => {
                        AppSettings.haptic_feedback = !AppSettings.haptic_feedback;
                        AppSettings.preferences_changed();
                    }
                }

                HorizontalLayout {
                    padding: 8px;
                    // Room for a subtitle that wraps (MD3: 12 for three lines;
                    // the card's 72 minimum keeps shorter rows as they were).
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: SettingsLayout.inset;
                    padding-right: SettingsLayout.inset;
                    alignment: space-between;
                    spacing: 16px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: @tr("Haptic Feedback");
                            font-size: 18px;
                            font-weight: 600;
                            color: root.text_color;
                        }

                        Text {
                            text: @tr("Enable haptic feedback for some actions");
                            font-size: 13px;
                            color: root.text_color.transparentize(30%);
                        }
                    }

                    ModernSwitch {
                        checked <=> AppSettings.haptic_feedback;
                        toggled => { AppSettings.preferences_changed(); }
                    }
                }
            }
        }
    }
}
