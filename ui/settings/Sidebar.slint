import { SettingsTab } from "Enums.slint";
import { AppSettings } from "../globals/AppSettings.slint";
import { AccentColor, ThemeSettings } from "../themes/theme.slint";
import { SettingsLayout } from "SettingsCard.slint";
import { Shine } from "../components/Shine.slint";

component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <string> subtitle;
    // Material Symbols (rounded): outlined, and filled. MD3: portrait's
    // icons in their coloured circles are filled; the landscape drawer's
    // are outlined but for the selected item's.
    in property <image> icon;
    in property <image> icon_filled;
    in property <bool> active;
    in property <bool> is_landscape;
    in property <color> icon_bg_color;
    in property <color> text_color: #FFFFFF;
    // Where it sits in the list (portrait's cards round the ends).
    in property <bool> first: false;
    in property <bool> last: false;

    callback clicked();

    property <bool> card: SettingsLayout.cards && !root.is_landscape;

    // MD3: a list item in portrait (two-line, 72, 16 corners as it's inset),
    // a navigation drawer item in landscape (56, a full pill).
    // On a phone held upright, a card of the page's group (SettingsCard).
    min-height: root.is_landscape ? 56px : 72px;
    border-top-left-radius: root.is_landscape ? 28px : !root.card ? 16px : root.first ? 20px : 4px;
    border-top-right-radius: self.border-top-left-radius;
    border-bottom-left-radius: root.is_landscape ? 28px : !root.card ? 16px : root.last ? 20px : 4px;
    border-bottom-right-radius: self.border-bottom-left-radius;
    // Material 3's navigation drawer: the selected item on the secondary
    // container, its icon and label in the colour for on it.
    background: root.active ? ThemeSettings.secondary_container
        : root.card ? (ta.has-hover ? ThemeSettings.card.mix(root.text_color, 92%) : ThemeSettings.card)
        : ta.has-hover ? ThemeSettings.hover_color : transparent;

    animate background {
        duration: ta.has-hover ? 120ms : ThemeSettings.fade;
        easing: ease-in-out;
    }
    clip: root.card;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    layout := HorizontalLayout {
        property <brush> icon_bg_color: ThemeSettings.accent == AccentColor.Greyscale ? ThemeSettings.primary_accent : parent.icon_bg_color;

        // Portrait: 16 from the screen edge with the page's 12. Landscape:
        // the drawer item's 16 and 24 inside its pill.
        padding-top: root.is_landscape ? 0px : 8px;
        padding-bottom: root.is_landscape ? 0px : 8px;
        padding-left: root.is_landscape ? 16px : SettingsLayout.inset;
        padding-right: root.is_landscape ? 24px : SettingsLayout.inset;
        spacing: root.is_landscape ? 12px : 16px;
        alignment: start;
        cross-axis-alignment: center;

        // Portrait filled icon container
        // MD3 list item's leading icon: 40, its icon 24.
        if !root.is_landscape: Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            // Greyscale in light mode: a light neutral circle (as the other
            // accents' pastel ones), not the accent's mid grey.
            property <bool> grey_light: ThemeSettings.accent == AccentColor.Greyscale && !ThemeSettings.is_dark;
            background: ThemeSettings.is_dark ? icon_bg_color : self.grey_light ? #e3e3e3 : icon_bg_color.mix(Colors.white, 80%);

            Image {
                source: root.icon_filled;
                width: 24px;
                height: 24px;
                colorize: ThemeSettings.is_dark ? #1e1e2e : parent.grey_light ? #3a3a3a : #2d3748;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.is_landscape: Image {
            source: root.active ? root.icon_filled : root.icon;
            width: 24px;
            height: 24px;
            colorize: root.active ? ThemeSettings.on_secondary_container : root.text_color;
        }

        // Text layout with horizontal-stretch and word-wrap to prevent horizontal expansion/scrolling
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.text;
                color: root.active ? ThemeSettings.on_secondary_container : root.text_color;
                // A drawer item's label: 14.
                font-size: root.is_landscape ? 14px : 15px;
                font-weight: root.active ? 600 : 500;
                wrap: word-wrap;
                animate color {
                    duration: 400ms;
                    easing: ease-out-expo;
                }
            }

            // A drawer item is its label alone.
            if !root.is_landscape: Text {
                text: root.subtitle;
                color: root.active ? ThemeSettings.on_secondary_container.transparentize(20%) : root.text_color.transparentize(40%);
                font-size: 12px;
                wrap: word-wrap;
                animate color {
                    duration: 400ms;
                    easing: ease-out-quint;
                }
            }
        }
    }

    if root.card: Shine {
        width: 100%;
        height: 100%;
    }
}

export component Sidebar inherits Rectangle {
    in property <color> text_color: #FFFFFF;
    // True once the content has scrolled away from the top; tints the settings header.
    out property <bool> scrolled: scroller.content-y < 0;
    in property <bool> is_landscape;
    in-out property <SettingsTab> active_tab: SettingsTab.InActive;
    out property <SettingsTab> appearance_tab: SettingsTab.Appearance;
    out property <SettingsTab> download_tab: SettingsTab.Download;
    out property <SettingsTab> general_tab: SettingsTab.General;
    out property <SettingsTab> advanced_tab: SettingsTab.Advanced;
    out property <SettingsTab> about_tab: SettingsTab.About;

    callback item_selected(SettingsTab);

    TouchArea { }

    scroller := Flickable {
        width: 100%;
        height: 100%;
        content-width: parent.width; // Prevents any horizontal scrolling
        content-height: sidebar_layout.preferred-height;

        sidebar_layout := VerticalLayout {
            width: parent.width;
            // MD3 lists and drawers: no gaps, the items' own height is the space.
            spacing: root.is_landscape ? 0px : SettingsLayout.spacing;
            padding-left: root.is_landscape ? 0px : SettingsLayout.side;
            // A drawer's pill stays 12 from its edges (the page gives the left).
            padding-right: root.is_landscape ? 12px : SettingsLayout.side;
            padding-top: 8px;
            // Room under the last item, so it doesn't end at the edge.
            padding-bottom: 24px;
            alignment: start;

            SidebarItem {
                width: 100%;
                first: true;
                text: @tr("Appearance");
                subtitle: @tr("Change themes & accent color");
                icon: @image-url("../icons/rounded/palette.svg");
                icon_filled: @image-url("../icons/rounded/filled/palette.svg");
                active: root.active_tab == appearance_tab;
                is_landscape: root.is_landscape;
                icon_bg_color: #ffbcff;
                text_color: root.text_color;
                clicked => {
                    root.active_tab = appearance_tab;
                    root.item_selected(appearance_tab);
                }
            }

            SidebarItem {
                width: 100%;
                text: @tr("General");
                subtitle: @tr("Language, haptics");
                icon: @image-url("../icons/rounded/settings.svg");
                icon_filled: @image-url("../icons/rounded/filled/settings.svg");
                active: root.active_tab == general_tab;
                is_landscape: root.is_landscape;
                icon_bg_color: #ffd8be;
                text_color: root.text_color;
                clicked => {
                    root.active_tab = general_tab;
                    root.item_selected(general_tab);
                }
            }

            SidebarItem {
                width: 100%;
                text: @tr("Downloads");
                subtitle: @tr("Folder, cookies, books, yt-dlp packages");
                icon: @image-url("../icons/rounded/download.svg");
                icon_filled: @image-url("../icons/rounded/filled/download.svg");
                active: root.active_tab == download_tab || root.active_tab == SettingsTab.Packages || root.active_tab == SettingsTab.Books || root.active_tab == SettingsTab.Downloading || root.active_tab == SettingsTab.Cookies;
                is_landscape: root.is_landscape;
                icon_bg_color: #cbe4de;
                text_color: root.text_color;
                clicked => {
                    root.active_tab = download_tab;
                    root.item_selected(download_tab);
                }
            }

            SidebarItem {
                width: 100%;
                text: @tr("Advanced");
                subtitle: @tr("Download cache");
                icon: @image-url("../icons/rounded/tune.svg");
                icon_filled: @image-url("../icons/rounded/filled/tune.svg");
                active: root.active_tab == advanced_tab;
                is_landscape: root.is_landscape;
                icon_bg_color: #c8d3ff;
                text_color: root.text_color;
                clicked => {
                    root.active_tab = advanced_tab;
                    root.item_selected(advanced_tab);
                }
            }

            SidebarItem {
                width: 100%;
                last: true;
                text: @tr("About");
                subtitle: @tr("Version, developer, source code");
                icon: @image-url("../icons/rounded/info.svg");
                icon_filled: @image-url("../icons/rounded/filled/info.svg");
                active: root.active_tab == about_tab;
                is_landscape: root.is_landscape;
                icon_bg_color: #d9e7c4;
                text_color: root.text_color;
                clicked => {
                    root.active_tab = about_tab;
                    root.item_selected(about_tab);
                }
            }
        }
    }
}
