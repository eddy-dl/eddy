import { ThemeSettings } from "../themes/theme.slint";
import { Shine } from "../components/Shine.slint";

// How settings rows are laid out. On a phone they're grouped
// as Google Messages (MD3 Expressive) does: each row its own card, 2px
// apart, big corners at a group's ends. Desktop keeps flat MD3 list items.
export global SettingsLayout {
    // Set by the desktop app. Not from AppSettings.is_mobile, which only
    // Android's Rust sets: the viewer shows the phone's layout.
    in-out property <bool> desktop;
    out property <bool> cards: !self.desktop;
    // Between rows, and the page's side padding (16 from the screen edge
    // with the page's own 12).
    out property <length> spacing: self.cards ? 2px : 0px;
    out property <length> side: self.cards ? 4px : 0px;
    // A row's content from its edges.
    out property <length> inset: self.cards ? 16px : 4px;
    // Between two groups of cards.
    out property <length> group_gap: self.cards ? 14px : 0px;
}

// A settings row's background. `first` / `last`: where it sits in its group.
// `plain` keeps it flat whatever the layout (rows in sheets).
export component SettingsCard inherits Rectangle {
    in property <bool> first: true;
    in property <bool> last: true;
    in property <bool> plain: false;
    in property <bool> highlighted: false;
    in property <color> text_color: ThemeSettings.text_color;

    property <bool> card: SettingsLayout.cards && !root.plain;
    property <length> end_radius: root.card ? 20px : 16px;
    property <length> inner_radius: root.card ? 4px : 16px;

    // MD3 two-line list item.
    min-height: 72px;
    border-top-left-radius: root.first ? root.end_radius : root.inner_radius;
    border-top-right-radius: self.border-top-left-radius;
    border-bottom-left-radius: root.last ? root.end_radius : root.inner_radius;
    border-bottom-right-radius: self.border-bottom-left-radius;
    background: root.card
        ? (root.highlighted ? ThemeSettings.card.mix(root.text_color, 92%) : ThemeSettings.card)
        : (root.highlighted ? ThemeSettings.hover_color : transparent);
    // With the page's own fade; a quick one for a tap.
    animate background { duration: root.highlighted ? 120ms : ThemeSettings.fade; easing: ease-in-out; }
    // The shine stays inside the card's corners.
    clip: root.card;

    @children

    // A sweep of the new colour when the accent changes.
    if root.card: Shine {
        width: 100%;
        height: 100%;
    }
}
