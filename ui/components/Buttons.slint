import { ThemeSettings } from "../themes/theme.slint";

// MD3 common button, full-width in sheets and dialogs: fully rounded, a
// 14 label, and a state layer when pressed. `primary` is a filled button,
// `danger` a filled one in the error colour, otherwise it's tonal (the
// secondary container) so it reads as a button on any surface;
// `destructive` gives that tonal one an error-coloured label. With
// `has_icon`, `icon` leads the label (MD3: 18, 8 before it).
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    // Larger for glyphs drawn small in their box (pause, play).
    in property <length> icon_size: 18px;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> destructive: false;
    callback clicked;

    height: 56px;
    border-radius: self.height / 2;

    private property <color> container: root.primary ? ThemeSettings.primary_accent
        : root.danger ? #E5534B
        : ThemeSettings.secondary_container;
    private property <color> content: root.primary || root.danger ? #ffffff
        : root.destructive ? #E5534B
        : ThemeSettings.on_secondary_container;

    background: root.container;
    animate background { duration: 200ms; }

    // State layer: the label's colour, 12% while pressed.
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? root.content.transparentize(88%) : transparent;
        animate background { duration: 100ms; }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        if root.has_icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: root.icon_size;
                height: root.icon_size;
                colorize: root.content;
            }
        }
        Text {
            text: root.text;
            color: root.content;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

export component ColorCircle inherits Rectangle {
    in property <color> fill_color;
    // A pair's second colour: the circle splits diagonally between the two.
    in property <color> second_color: root.fill_color;
    in property <bool> is_active: false;
    property <bool> is-pulsing: ta.pressed;
    callback clicked;

    width: 48px;
    height: 48px;
    border-radius: 24px;
    // A hard stop: two halves (one colour for a single accent).
    background: @linear-gradient(135deg, root.fill_color 50%, root.second_color 50%);

    border-width: 0px;
    border-color: ThemeSettings.text_color;

    ta := TouchArea {
        clicked => { root.clicked() }
    }

    states [
        pulse-state when root.is-pulsing: {
            root.border-width: 8px;
            in {
                animate root.border-width {
                    duration: 100ms;
                    easing: ease-out;
                }
            }
            out {
                animate root.border-width {
                    duration: 250ms;
                    easing: ease-in-out;
                }
            }
        }
        active-state when root.is_active && !ta.pressed: {
            root.border-width: 4px;
            in {
                animate root.border-width {
                    duration: 150ms;
                    easing: ease-in-out;
                }
            }
            out {
                animate root.border-width {
                    duration: 150ms;
                    easing: ease-in-out;
                }
            }
        }
    ]
}


// MD3 switch: a 52×32 track; the handle 16 (off) or 24 with a check (on),
// 28 while pressed, with a 40 state layer round it. No shadow: MD3's handle
// is flat.
export component ModernSwitch inherits Rectangle {
    in-out property <bool> checked;
    // Pressed from outside (a row that toggles it on its own tap).
    in property <bool> held: false;
    callback toggled;

    private property <bool> pressed: ta.pressed || root.held;
    private property <bool> hovered: ta.has-hover;
    // MD3 roles: primary / on-primary, and on-primary-container for the
    // check; off, surface-container-highest with an outline.
    private property <color> on_track: ThemeSettings.is_dark ? Colors.white.mix(ThemeSettings.primary_accent, 40%) : ThemeSettings.primary_accent;
    private property <color> on_handle: ThemeSettings.is_dark ? ThemeSettings.primary_accent.darker(2.0) : #ffffff;
    private property <color> on_icon: ThemeSettings.is_dark ? root.on_track : ThemeSettings.primary_accent.darker(0.6);
    private property <color> outline: ThemeSettings.is_dark ? #8E918F : #747775;
    private property <color> off_track: ThemeSettings.is_dark ? #444746 : #E3E3E3;

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: root.checked ? root.on_track : root.off_track;
    border-width: root.checked ? 0px : 2px;
    border-color: root.checked ? transparent : root.outline;
    animate background, border-color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

    // Handle's centre: 16 from the end it's at.
    private property <length> centre: root.checked ? root.width - 16px : 16px;
    animate centre { duration: 250ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
    private property <length> size: root.pressed ? 28px : root.checked ? 24px : 16px;
    animate size { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

    // State layer: 8% hovered, 12% pressed, in the handle's role colour.
    Rectangle {
        width: 40px;
        height: 40px;
        x: root.centre - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: (root.checked ? root.on_track : ThemeSettings.text_color)
            .transparentize(root.pressed ? 88% : root.hovered ? 92% : 100%);
        animate background { duration: 150ms; }
    }

    Rectangle {
        width: root.size;
        height: root.size;
        x: root.centre - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        // Off and pressed: on-surface-variant.
        background: root.checked ? root.on_handle : root.pressed ? ThemeSettings.text_color.transparentize(25%) : root.outline;
        animate background { duration: 200ms; }

        Image {
            source: @image-url("../icons/rounded/check.svg");
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: root.on_icon;
            opacity: root.checked ? 1 : 0;
            animate opacity { duration: 150ms; }
        }
    }

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}
