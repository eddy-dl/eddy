// Pacifico (SIL Open Font License, ../fonts/OFL-Pacifico.txt).
import "../fonts/Pacifico-Regular.ttf";
import { ThemeSettings } from "../themes/theme.slint";

// Eddy's name as a logo: the word in a flowing script, a wave in the
// accent colour following its letters underneath.
export component Wordmark inherits Rectangle {
    in property <length> font-size: 30px;

    width: name.preferred-width + 4px;
    // Room for the wave, set below the letters.
    height: name.preferred-height + root.font-size * 0.1;

    name := Text {
        x: 0;
        y: 0;
        text: "Eddy";
        font-family: "Pacifico";
        font-size: root.font-size;
        color: ThemeSettings.text_color;
    }

    // The wave's outline, in the font's units (see the Path below): a
    // ribbon along the letters' bottoms, tapering at both ends, its crests
    // leaning with the script and the last rolling into a curl. Made from
    // the font's outlines by a script (envelope + ribbon), not by hand.
    property <string> wave: "M 175 185 L 175 190 L 177 193 L 179 197 L 182 202 L 185 206 L 189 210 L 193 214 L 196 217 L 200 221 L 204 223 L 208 226 L 212 229 L 216 232 L 220 234 L 224 237 L 228 239 L 232 241 L 236 243 L 240 245 L 245 248 L 249 249 L 254 251 L 258 253 L 263 255 L 268 257 L 272 258 L 277 260 L 282 261 L 287 262 L 291 264 L 296 265 L 301 266 L 306 267 L 311 268 L 316 269 L 320 270 L 325 271 L 330 272 L 335 273 L 340 274 L 344 274 L 349 275 L 354 276 L 359 277 L 364 277 L 369 278 L 374 279 L 380 279 L 385 280 L 390 280 L 396 280 L 401 281 L 406 281 L 411 281 L 416 282 L 421 282 L 427 282 L 432 282 L 437 282 L 442 282 L 448 282 L 453 282 L 458 283 L 463 283 L 469 283 L 474 282 L 479 282 L 485 282 L 490 282 L 496 282 L 501 282 L 506 282 L 512 281 L 517 281 L 522 281 L 528 281 L 533 280 L 539 280 L 545 280 L 551 279 L 558 278 L 564 277 L 570 276 L 576 275 L 581 274 L 587 274 L 593 273 L 598 272 L 603 271 L 609 270 L 614 269 L 620 269 L 626 268 L 632 267 L 638 266 L 644 264 L 651 263 L 657 262 L 664 260 L 670 258 L 676 257 L 682 255 L 688 254 L 693 253 L 699 251 L 704 250 L 710 249 L 716 247 L 722 246 L 729 244 L 736 242 L 744 240 L 754 236 L 763 232 L 771 228 L 777 224 L 781 222 L 782 222 L 776 223 L 760 219 L 745 207 L 741 200 L 741 200 L 741 204 L 742 212 L 743 221 L 746 234 L 752 248 L 760 259 L 767 266 L 774 272 L 782 278 L 789 282 L 796 285 L 802 287 L 808 289 L 816 292 L 825 293 L 832 294 L 839 294 L 845 294 L 851 294 L 856 294 L 860 294 L 864 295 L 869 295 L 875 295 L 881 295 L 888 295 L 895 294 L 902 294 L 910 292 L 917 291 L 924 289 L 931 288 L 938 285 L 946 283 L 954 280 L 962 277 L 971 273 L 980 268 L 990 262 L 998 256 L 1006 251 L 1014 246 L 1020 241 L 1025 238 L 1030 236 L 1034 234 L 1040 232 L 1044 230 L 1046 229 L 1047 229 L 1044 229 L 1038 228 L 1028 223 L 1019 214 L 1016 208 L 1017 209 L 1018 214 L 1019 222 L 1021 231 L 1024 243 L 1032 257 L 1041 267 L 1049 275 L 1058 280 L 1066 284 L 1074 287 L 1080 288 L 1086 290 L 1092 291 L 1099 292 L 1107 293 L 1114 293 L 1121 293 L 1127 293 L 1134 292 L 1140 291 L 1145 291 L 1151 290 L 1157 289 L 1163 288 L 1170 287 L 1177 286 L 1184 284 L 1191 282 L 1199 279 L 1207 276 L 1215 273 L 1222 270 L 1229 266 L 1236 262 L 1243 259 L 1250 256 L 1257 252 L 1265 248 L 1273 243 L 1281 238 L 1287 234 L 1293 231 L 1295 229 L 1294 229 L 1285 229 L 1272 223 L 1266 216 L 1265 214 L 1266 217 L 1268 222 L 1270 230 L 1274 240 L 1281 251 L 1288 258 L 1294 263 L 1300 267 L 1306 271 L 1312 274 L 1319 277 L 1325 279 L 1332 281 L 1340 283 L 1347 284 L 1354 284 L 1361 284 L 1367 284 L 1372 283 L 1377 283 L 1381 283 L 1386 282 L 1391 282 L 1396 282 L 1402 282 L 1409 281 L 1415 280 L 1423 279 L 1430 277 L 1436 276 L 1443 274 L 1450 271 L 1457 269 L 1464 266 L 1472 262 L 1479 258 L 1488 254 L 1497 248 L 1506 241 L 1515 234 L 1523 227 L 1531 221 L 1537 216 L 1542 212 L 1545 211 L 1546 210 L 1547 210 L 1547 210 L 1546 210 L 1547 209 L 1547 210 L 1549 211 L 1550 211 L 1550 211 L 1551 212 L 1552 216 L 1554 221 L 1556 228 L 1559 235 L 1563 244 L 1569 252 L 1578 259 L 1586 263 L 1593 265 L 1600 267 L 1606 268 L 1611 268 L 1614 268 L 1610 267 L 1626 269 L 1637 266 L 1647 261 L 1657 254 L 1666 247 L 1674 239 L 1681 230 L 1687 221 L 1691 211 L 1695 201 L 1696 190 L 1697 180 L 1697 170 L 1695 160 L 1692 150 L 1688 141 L 1683 133 L 1678 126 L 1671 119 L 1664 114 L 1657 109 L 1649 105 L 1641 103 L 1633 101 L 1624 100 L 1617 101 L 1609 102 L 1602 104 L 1595 107 L 1588 111 L 1583 115 L 1578 120 L 1574 125 L 1570 131 L 1568 137 L 1566 143 L 1565 149 L 1565 154 L 1566 160 L 1566 160 L 1568 155 L 1570 150 L 1572 145 L 1575 140 L 1578 136 L 1582 132 L 1586 128 L 1590 125 L 1595 123 L 1600 121 L 1606 120 L 1611 119 L 1617 119 L 1623 120 L 1628 121 L 1634 123 L 1639 126 L 1644 129 L 1649 133 L 1653 137 L 1656 142 L 1659 148 L 1661 153 L 1663 159 L 1664 165 L 1664 172 L 1664 178 L 1663 184 L 1661 190 L 1658 196 L 1654 202 L 1650 207 L 1646 212 L 1641 216 L 1635 219 L 1629 222 L 1622 224 L 1615 226 L 1631 227 L 1623 224 L 1618 223 L 1614 222 L 1610 221 L 1607 220 L 1604 219 L 1604 219 L 1605 219 L 1606 220 L 1605 218 L 1604 214 L 1603 208 L 1602 201 L 1600 194 L 1596 185 L 1590 176 L 1585 171 L 1579 166 L 1573 162 L 1565 158 L 1556 155 L 1546 154 L 1536 155 L 1526 157 L 1515 161 L 1506 167 L 1496 173 L 1487 179 L 1478 185 L 1470 191 L 1463 195 L 1457 198 L 1451 201 L 1446 203 L 1440 205 L 1435 206 L 1430 208 L 1425 209 L 1420 210 L 1415 211 L 1411 212 L 1407 212 L 1404 212 L 1400 212 L 1395 212 L 1391 212 L 1386 212 L 1380 211 L 1375 211 L 1369 211 L 1365 211 L 1360 211 L 1357 211 L 1354 211 L 1353 210 L 1351 210 L 1350 209 L 1348 208 L 1346 207 L 1345 206 L 1343 205 L 1342 204 L 1341 203 L 1342 204 L 1343 206 L 1343 206 L 1343 201 L 1341 195 L 1338 186 L 1333 174 L 1321 160 L 1300 151 L 1281 150 L 1267 154 L 1257 158 L 1248 163 L 1239 168 L 1232 172 L 1226 175 L 1220 178 L 1214 180 L 1207 184 L 1200 187 L 1193 190 L 1187 192 L 1182 195 L 1176 196 L 1172 198 L 1168 199 L 1163 200 L 1159 201 L 1155 201 L 1151 202 L 1146 202 L 1141 203 L 1136 203 L 1132 204 L 1127 204 L 1123 204 L 1119 204 L 1116 204 L 1113 204 L 1111 204 L 1109 203 L 1106 202 L 1103 202 L 1102 201 L 1101 201 L 1101 201 L 1102 201 L 1104 203 L 1107 206 L 1109 210 L 1110 211 L 1109 207 L 1108 200 L 1107 191 L 1104 179 L 1097 164 L 1082 148 L 1063 139 L 1048 137 L 1035 137 L 1024 139 L 1015 142 L 1006 145 L 999 148 L 991 151 L 981 156 L 971 161 L 963 167 L 954 172 L 946 178 L 940 182 L 934 185 L 929 188 L 925 190 L 920 192 L 915 193 L 911 195 L 906 196 L 902 197 L 897 198 L 893 199 L 890 199 L 887 200 L 884 200 L 880 200 L 876 200 L 872 200 L 867 200 L 862 200 L 856 199 L 851 200 L 846 200 L 842 199 L 840 199 L 838 199 L 837 199 L 836 199 L 835 198 L 833 198 L 831 197 L 831 197 L 831 197 L 832 198 L 832 198 L 834 201 L 836 205 L 836 205 L 835 200 L 834 192 L 833 182 L 829 170 L 820 152 L 799 135 L 773 130 L 756 133 L 744 137 L 735 142 L 727 146 L 721 150 L 716 152 L 713 153 L 709 155 L 704 156 L 699 158 L 694 159 L 688 161 L 682 162 L 676 164 L 670 166 L 664 168 L 658 169 L 652 171 L 646 173 L 641 175 L 635 176 L 630 178 L 625 179 L 620 180 L 615 182 L 610 183 L 605 184 L 599 185 L 594 186 L 588 187 L 582 189 L 576 190 L 571 191 L 565 193 L 560 194 L 554 195 L 549 196 L 544 197 L 540 198 L 535 199 L 530 200 L 525 201 L 520 201 L 515 202 L 510 203 L 505 203 L 500 204 L 495 205 L 490 205 L 485 206 L 480 206 L 475 207 L 470 208 L 465 208 L 460 209 L 455 209 L 450 210 L 445 210 L 440 211 L 435 211 L 430 211 L 425 212 L 420 212 L 415 213 L 410 213 L 405 213 L 401 214 L 396 214 L 391 214 L 387 215 L 382 215 L 377 215 L 373 215 L 368 215 L 364 215 L 359 215 L 355 215 L 350 215 L 345 215 L 340 215 L 336 215 L 331 215 L 326 215 L 322 215 L 317 214 L 313 214 L 309 214 L 304 214 L 300 213 L 295 213 L 291 213 L 287 212 L 282 212 L 278 212 L 274 211 L 270 210 L 266 210 L 262 209 L 258 208 L 254 208 L 250 207 L 246 206 L 242 205 L 238 204 L 233 203 L 229 202 L 225 200 L 222 199 L 218 198 L 214 197 L 210 195 L 206 194 L 201 192 L 197 190 L 192 188 L 187 187 L 183 185 L 179 184 L 175 185 Z";

    // A faint copy a little behind and below, for depth.
    Path {
        x: root.font-size * 0.03;
        y: root.font-size * 0.06;
        width: root.font-size * 2.2;
        height: root.font-size * 1.76;
        viewbox-x: 0;
        viewbox-y: -1303;
        viewbox-width: 2200;
        viewbox-height: 1760;
        commands: root.wave;
        fill: ThemeSettings.secondary_accent.transparentize(72%);
        animate fill { duration: 300ms; }
    }

    // Under the letters, with room between; drawn over the text's box in
    // the font's units (1000 an em, y down from the baseline), so it
    // follows the letters at any size.
    Path {
        x: 0;
        y: 0;
        width: root.font-size * 2.2;
        height: root.font-size * 1.76;
        viewbox-x: 0;
        viewbox-y: -1303; // the font's ascent: the text box's top
        viewbox-width: 2200;
        viewbox-height: 1760;
        commands: root.wave;
        // A pair: from its main colour into its second, along the wave (it
        // spans x 175 to 1697 of the 2200 box). A single accent: lighter at
        // the crests, deeper at its base (the ribbon's y 100 to 295 under a
        // 1303 ascent, of 1760).
        fill: ThemeSettings.is_pair
            ? @linear-gradient(90deg,
                ThemeSettings.primary_accent 8%,
                ThemeSettings.secondary_accent 77%)
            : @linear-gradient(180deg,
                ThemeSettings.primary_accent.mix(#ffffff, 55%) 79.5%,
                ThemeSettings.primary_accent 87%,
                ThemeSettings.primary_accent.darker(0.15) 91%);
    }
}
