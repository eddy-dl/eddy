import { WrappedText } from "WrappedText.slint";
import { ModernSwitch } from "Buttons.slint";
import { ThemeSettings } from "../themes/theme.slint";
import { SettingsCard, SettingsLayout } from "../settings/SettingsCard.slint";

// A setting that's on or off: title, an optional explanation, and a switch.
// The whole row toggles it. `compact` is for sheets (smaller text).
export component SwitchRow inherits SettingsCard {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> compact: false;
    // No inset at the sides: for rows inside an already padded layout.
    in property <bool> flush: false;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    // MD3 list items: two-line in settings, one-line in sheets (compact).
    // Sheets' rows stay flat; settings' join the page's cards.
    plain: root.compact || root.flush;
    min-height: root.compact ? 56px : 72px;
    highlighted: ta.has-hover && root.enabled;
    opacity: root.enabled ? 1.0 : 0.45;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        padding: root.compact ? 4px : 8px;
        // Settings rows: MD3 list items, 16 from the edge with the page's
        // own 12.
        padding-left: root.flush ? 0px : root.compact ? 4px : SettingsLayout.inset;
        padding-right: self.padding-left;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            WrappedText {
                text: root.title;
                font-size: root.compact ? 15px : 18px;
                font-weight: root.compact ? 500 : 600;
                color: root.text_color;
            }
            if root.subtitle != "": WrappedText {
                text: root.subtitle;
                font-size: root.compact ? 12px : 13px;
                color: root.text_color.transparentize(40%);
            }
        }

        VerticalLayout {
            alignment: center;
            // Over the switch, so a tap on it goes through the row's handler.
            Rectangle {
                width: switch.width;
                height: switch.height;
                switch := ModernSwitch {
                    checked: root.checked;
                    held: switch_ta.pressed;
                }
                switch_ta := TouchArea {
                    enabled: root.enabled;
                    clicked => {
                        root.checked = !root.checked;
                        root.toggled();
                    }
                }
            }
        }
    }
}
