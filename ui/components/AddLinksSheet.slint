import { TextArea } from "TextArea.slint";
import { SwitchRow } from "SwitchRow.slint";
import { AppSettings } from "../globals/AppSettings.slint";
import { ThemeSettings } from "../themes/theme.slint";
import { ActionButton } from "Buttons.slint";

// Sheet for pasting links: any text works, the Rust side picks the links out
// of it. `process` hands the text over; the owner closes the sheet.
export component AddLinksSheet inherits Rectangle {
    in-out property <string> text;
    callback process();
    callback cancel();

    // Moves the keyboard to the text box (called when the sheet opens), and
    // starts "Links with spaces" from Settings again.
    public function focus_input() {
        root.spaces = AppSettings.links_with_spaces;
        input.focus();
    }

    // "Links with spaces", for this paste only (Settings keeps its own).
    out property <bool> spaces: AppSettings.links_with_spaces;

    private property <bool> has_text: !root.text.is-empty;

    // Takes the focus off the text box before Add reads it.
    park := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    height: layout.preferred-height;
    background: ThemeSettings.surface;
    animate background { duration: ThemeSettings.fade; easing: ease-in-out; }
    border-radius: 16px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000020;

    // Keeps taps on the sheet's gaps from reaching the backdrop behind it.
    TouchArea { }

    layout := VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            Text {
                text: @tr("Add links");
                font-size: 16px;
                font-weight: 700;
                color: ThemeSettings.text_color;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // Text button. Pastes at the cursor, or at the end with no cursor.
            Rectangle {
                width: paste_label.preferred-width + 24px;
                height: 32px;
                border-radius: 16px;
                background: ta_paste.pressed ? ThemeSettings.text_color.transparentize(88%) : transparent;
                animate background { duration: 150ms; }
                paste_label := Text {
                    text: @tr("Paste");
                    font-size: 14px;
                    font-weight: 600;
                    color: ThemeSettings.primary_accent;
                    vertical-alignment: center;
                }
                ta_paste := TouchArea {
                    clicked => { input.paste(); }
                }
            }
        }

        // Eddy's own, in its theme's colours (TextEdit follows the system's).
        input := TextArea {
            text <=> root.text;
            height: 160px;
            font-size: 14px;
            // Links are long words: broken anywhere.
            wrap: TextWrap.char-wrap;
            input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
            placeholder-text: @tr("Paste links, or any text containing them");
        }

        SwitchRow {
            flush: true;
            compact: true;
            title: @tr("Links with spaces");
            subtitle: @tr("For this paste: Settings keeps its own");
            checked <=> root.spaces;
        }

        Text {
            text: @tr("Each link is checked before it's added, so you can pick how to download it.");
            font-size: 12px;
            color: ThemeSettings.text_color.transparentize(35%);
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            ActionButton {
                text: @tr("Cancel");
                horizontal-stretch: 1;
                height: 48px;
                clicked => { root.cancel(); }
            }
            ActionButton {
                text: @tr("Process");
                primary: true;
                horizontal-stretch: 1;
                height: 48px;
                opacity: root.has_text ? 1.0 : 0.4;
                animate opacity { duration: 150ms; }
                clicked => {
                    // The keyboard's unfinished word (a suggestion still underlined) only
                    // reaches the field when it loses focus: so first, or it's left out.
                    park.focus();
                    if (root.has_text) {
                        root.process();
                    }
                }
            }
        }
    }
}
