import { TextField } from "TextField.slint";
import { ThemeSettings } from "../themes/theme.slint";
import { ActionButton } from "Buttons.slint";
import { SectionLabel } from "Chips.slint";
import { FolderBrowser } from "../globals/FolderBrowser.slint";

component FolderRow inherits Rectangle {
    in property <string> name;
    in property <bool> is_up: false;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: ta.pressed ? ThemeSettings.text_color.transparentize(90%) : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 22px;
                height: 22px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: ThemeSettings.text_color.transparentize(20%);
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
                commands: root.is_up
                    ? "M12 19V5M5 12l7 -7l7 7"
                    : "M3 7a2 2 0 0 1 2 -2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2z";
            }
        }
        Text {
            text: root.name;
            font-size: 15px;
            color: ThemeSettings.text_color;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// Picking a folder by browsing storage: up, into folders, a new one, then
// "Use this folder". Covers the window it's in.
export component FolderBrowserSheet inherits Rectangle {
    in property <length> safe_top;
    in property <length> safe_bottom;
    // How much of the window the on-screen keyboard covers (0 when it's
    // down), so the name field and buttons stay above it.
    in property <length> keyboard;

    private property <string> new_name;
    private property <bool> naming: false;

    // The page's background, so the plain buttons (surface) stand out.
    background: ThemeSettings.background;

    // Nothing behind it gets the taps; a tap off the name field takes the
    // focus back (so Back works again).
    TouchArea {
        clicked => { scope.focus(); }
    }

    // It sits outside the window's Back handling, so it has its own: Back
    // stops naming a new folder, then closes.
    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (root.naming) {
                    root.naming = false;
                    root.new_name = "";
                    self.focus();
                } else {
                    FolderBrowser.cancel();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            padding-top: Math.max(16px, root.safe_top + 8px);
            padding-bottom: Math.max(16px, root.safe_bottom + 8px, root.keyboard + 8px);
            spacing: 8px;

            Text {
                text: @tr("Choose a folder");
                font-size: 20px;
                font-weight: 700;
                color: ThemeSettings.text_color;
                height: self.preferred-height;
            }
            Text {
                text: FolderBrowser.path;
                font-size: 13px;
                color: ThemeSettings.primary_accent;
                wrap: word-wrap;
                height: self.preferred-height;
            }

            // Takes the space left; the folders scroll inside it.
            Rectangle {
                vertical-stretch: 1;
                Flickable {
                    width: 100%;
                    height: 100%;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        if FolderBrowser.can_up: FolderRow {
                            name: @tr("Up");
                            is_up: true;
                            clicked => { FolderBrowser.up(); }
                        }
                        for folder in FolderBrowser.folders: FolderRow {
                            name: folder;
                            clicked => { FolderBrowser.enter(folder); }
                        }
                        if FolderBrowser.folders.length == 0: Text {
                            text: @tr("No folders here");
                            font-size: 13px;
                            color: ThemeSettings.text_color.transparentize(40%);
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            if FolderBrowser.error != "": Text {
                text: FolderBrowser.error;
                font-size: 13px;
                color: #E5534B;
                wrap: word-wrap;
                height: self.preferred-height;
            }

            // A new folder inside this one.
            if root.naming: HorizontalLayout {
                spacing: 8px;
                TextField {
                    text <=> root.new_name;
                    placeholder-text: @tr("New folder's name");
                    horizontal-stretch: 1;
                    font-size: 14px;
                    init => { self.focus(); }
                }
                ActionButton {
                    text: @tr("Create");
                    primary: true;
                    width: 96px;
                    height: 44px;
                    opacity: root.new_name.is-empty ? 0.4 : 1.0;
                    clicked => {
                        if (!root.new_name.is-empty) {
                            FolderBrowser.create(root.new_name);
                            root.new_name = "";
                            root.naming = false;
                        }
                    }
                }
            }
            if !root.naming: FolderRow {
                name: @tr("New folder");
                clicked => { root.naming = true; }
            }

            HorizontalLayout {
                spacing: 12px;
                padding-top: 4px;
                ActionButton {
                    text: @tr("Cancel");
                    horizontal-stretch: 1;
                    height: 48px;
                    clicked => {
                        root.naming = false;
                        FolderBrowser.cancel();
                    }
                }
                ActionButton {
                    text: @tr("Use this folder");
                    primary: true;
                    horizontal-stretch: 1;
                    height: 48px;
                    clicked => {
                        root.naming = false;
                        FolderBrowser.choose();
                    }
                }
            }
        }
    }
}
