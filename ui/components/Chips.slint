import { ThemeSettings } from "../themes/theme.slint";

// Pill-shaped choice button; several in a row share the width (MD3's
// segmented buttons, 40 tall).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    horizontal-stretch: 1;
    height: 40px;
    border-radius: 20px;
    // Material 3's selected filter chip / segmented button: the secondary
    // container (a pair's second colour, softened).
    background: root.selected ? ThemeSettings.secondary_container : (ta.has-hover ? ThemeSettings.hover_color : transparent);
    border-width: root.selected ? 0px : 1px;
    border-color: ThemeSettings.text_color.transparentize(70%);
    animate background, border-width { duration: 150ms; }

    Text {
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: root.selected ? ThemeSettings.on_secondary_container : ThemeSettings.text_color;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 150ms; }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Small accent label above a group of options in a sheet.
export component SectionLabel inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: ThemeSettings.primary_accent;
}
