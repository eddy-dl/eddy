import { ThemeSettings } from "../themes/theme.slint";
import { ActionButton, ModernSwitch } from "Buttons.slint";
import { HoldTouchArea, HintBubble } from "HoldHint.slint";

export enum SelectionAction { Pause, Resume, Cancel, Delete }

// Round icon button for the selection bar. Holding it names it, below the
// header (the top of the screen leaves no room above).
component ActionIcon inherits Rectangle {
    in property <string> label;
    in property <string> commands; // 24-unit stroked path, like the nav icons
    in property <bool> danger: false;
    callback clicked();

    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: ta.pressed && !ta.holding ? ThemeSettings.hover_color : transparent;
    animate background { duration: 150ms; }

    Path {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.danger ? #E5534B : ThemeSettings.text_color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.commands;
    }

    ta := HoldTouchArea {
        tapped => { root.clicked(); }
    }

    HintBubble {
        text: root.label;
        shown: ta.holding;
        x: (parent.width - self.width) / 2;
        y: parent.height + 8px;
    }
}

// What can be done with the selected items, shown in the header while
// selecting. Only actions that apply to something selected appear:
// - Downloading: Pause (active or queued), Cancel
// - Stopped: Resume (paused, failed or cancelled), Cancel (paused), Delete
// - Completed: Delete
export component SelectionActionBar inherits HorizontalLayout {
    in property <int> tab; // 0 = Downloading, 1 = Stopped, 2 = Completed
    // How many of the selected items are in each state.
    in property <int> running; // active or queued
    in property <int> paused;
    in property <int> ended; // failed or cancelled

    callback action(SelectionAction);

    spacing: 0px;

    if root.tab == 0 && root.running > 0: ActionIcon {
        label: @tr("Pause");
        commands: "M9 6v12M15 6v12";
        clicked => { root.action(SelectionAction.Pause); }
    }
    if root.tab == 1 && root.paused + root.ended > 0: ActionIcon {
        label: root.paused > 0 ? @tr("Resume") : @tr("Retry");
        commands: "M8 5.5v13l10.5 -6.5z";
        clicked => { root.action(SelectionAction.Resume); }
    }
    if root.tab == 0 || (root.tab == 1 && root.paused > 0): ActionIcon {
        label: @tr("Cancel");
        commands: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M9 9l6 6M15 9l-6 6";
        clicked => { root.action(SelectionAction.Cancel); }
    }
    if root.tab != 0: ActionIcon {
        label: @tr("Delete");
        danger: true;
        commands: "M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2 -2l1 -12M9 7V4h6v3";
        clicked => { root.action(SelectionAction.Delete); }
    }
}

// Asks before deleting the selected downloads, with the option of deleting
// their files too.
export component DeleteConfirmSheet inherits Rectangle {
    in property <int> count;
    in-out property <bool> delete_files: false;
    callback confirm();
    callback cancel();

    height: layout.preferred-height;
    background: ThemeSettings.surface;
    border-radius: 16px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000020;

    // Keeps taps on the sheet's gaps from reaching the backdrop behind it.
    TouchArea { }

    layout := VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: @tr("Delete {n} download?" | "Delete {n} downloads?" % root.count);
            font-size: 16px;
            font-weight: 700;
            color: ThemeSettings.text_color;
            wrap: word-wrap;
        }

        Text {
            text: root.delete_files
                ? @tr("They're removed from the list and their files are deleted.")
                : @tr("They're removed from the list. Their files stay where they are.");
            font-size: 13px;
            color: ThemeSettings.text_color.transparentize(35%);
            wrap: word-wrap;
        }

        // The whole row toggles the switch.
        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: ta_files.pressed ? ThemeSettings.text_color.transparentize(92%) : transparent;

            ta_files := TouchArea {
                clicked => { root.delete_files = !root.delete_files; }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                Text {
                    text: @tr("Also delete the files");
                    font-size: 14px;
                    color: ThemeSettings.text_color;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    ModernSwitch {
                        checked <=> root.delete_files;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            ActionButton {
                text: @tr("Cancel");
                horizontal-stretch: 1;
                height: 48px;
                clicked => { root.cancel(); }
            }
            ActionButton {
                text: @tr("Delete");
                danger: true;
                horizontal-stretch: 1;
                height: 48px;
                clicked => { root.confirm(); }
            }
        }
    }
}
