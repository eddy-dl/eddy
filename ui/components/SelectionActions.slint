import { ThemeSettings } from "../themes/theme.slint";
import { ActionButton, ModernSwitch } from "Buttons.slint";
import { HoldTouchArea, HintBubble } from "HoldHint.slint";

export enum SelectionAction { Pause, Resume, Cancel, Delete, Share }

// MD3 standard icon button: a 24 Material Symbols (rounded) icon in
// on-surface-variant, a 40 circle
// of state layer on press, in a 48 touch target. Holding it names it (a
// plain tooltip), below it, as the top of the screen leaves no room above.
export component ActionIcon inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Some glyphs are drawn smaller in their box than others (pause, play):
    // a larger size evens them out with their neighbours.
    in property <length> icon_size: 24px;
    callback clicked();

    width: 48px;
    height: 48px;

    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: ta.pressed && !ta.holding ? ThemeSettings.text_color.transparentize(88%) : transparent;
        animate background { duration: 150ms; }
    }

    Image {
        source: root.icon;
        width: root.icon_size;
        height: root.icon_size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: ThemeSettings.text_color.transparentize(25%);
    }

    ta := HoldTouchArea {
        tapped => { root.clicked(); }
    }

    HintBubble {
        text: root.label;
        shown: ta.holding;
        x: (parent.width - self.width) / 2;
        y: parent.height + 8px;
    }
}

// The actions for the selected items, in the header while selecting (an
// MD3 contextual app bar). At most three show, MD3's limit and what fits
// beside the count; the rest go in the ⋮ menu (app.slint).
// - Downloading: Pause (active or queued), Cancel, Share (their links)
// - Stopped: Resume (paused, failed or cancelled), Delete, Share; Cancel
//   (paused) in the menu
// - Completed: Share (their files), Delete
export component SelectionActionBar inherits HorizontalLayout {
    in property <int> tab; // 0 = Downloading, 1 = Stopped, 2 = Completed
    // How many of the selected items are in each state.
    in property <int> running; // active or queued
    in property <int> paused;
    in property <int> ended; // failed or cancelled

    callback action(SelectionAction);

    spacing: 0px;
    // Only as wide as its icons, packed to the right: as a layout it would
    // otherwise take a share of the header's spare width, its icons at its
    // left (mid-header in landscape).
    horizontal-stretch: 0;
    alignment: end;

    if root.tab == 0 && root.running > 0: ActionIcon {
        label: @tr("Pause");
        icon: @image-url("../icons/rounded/pause.svg");
        icon_size: 30px;
        clicked => { root.action(SelectionAction.Pause); }
    }
    if root.tab == 1 && root.paused + root.ended > 0: ActionIcon {
        label: root.paused > 0 ? @tr("Resume") : @tr("Retry");
        icon: @image-url("../icons/rounded/play_arrow.svg");
        icon_size: 32px;
        clicked => { root.action(SelectionAction.Resume); }
    }
    if root.tab == 0: ActionIcon {
        label: @tr("Cancel");
        icon: @image-url("../icons/rounded/cancel.svg");
        clicked => { root.action(SelectionAction.Cancel); }
    }
    ActionIcon {
        label: root.tab == 2 ? @tr("Share files") : @tr("Share links");
        icon: @image-url("../icons/rounded/share.svg");
        clicked => { root.action(SelectionAction.Share); }
    }
    if root.tab != 0: ActionIcon {
        label: @tr("Delete");
        icon: @image-url("../icons/rounded/delete.svg");
        clicked => { root.action(SelectionAction.Delete); }
    }
}

// Asks before deleting the selected downloads, with the option of deleting
// their files too.
export component DeleteConfirmSheet inherits Rectangle {
    in property <int> count;
    in-out property <bool> delete_files: false;
    callback confirm();
    callback cancel();

    height: layout.preferred-height;
    background: ThemeSettings.surface;
    border-radius: 16px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000020;

    // Keeps taps on the sheet's gaps from reaching the backdrop behind it.
    TouchArea { }

    layout := VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: @tr("Delete {n} download?" | "Delete {n} downloads?" % root.count);
            font-size: 16px;
            font-weight: 700;
            color: ThemeSettings.text_color;
            wrap: word-wrap;
        }

        Text {
            text: root.delete_files
                ? @tr("They're removed from the list and their files are deleted.")
                : @tr("They're removed from the list. Their files stay where they are.");
            font-size: 13px;
            color: ThemeSettings.text_color.transparentize(35%);
            wrap: word-wrap;
        }

        // The whole row toggles the switch.
        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: ta_files.pressed ? ThemeSettings.text_color.transparentize(92%) : transparent;

            ta_files := TouchArea {
                clicked => { root.delete_files = !root.delete_files; }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                Text {
                    text: @tr("Also delete the files");
                    font-size: 14px;
                    color: ThemeSettings.text_color;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    ModernSwitch {
                        checked <=> root.delete_files;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            ActionButton {
                text: @tr("Cancel");
                horizontal-stretch: 1;
                height: 48px;
                clicked => { root.cancel(); }
            }
            ActionButton {
                text: @tr("Delete");
                danger: true;
                horizontal-stretch: 1;
                height: 48px;
                clicked => { root.confirm(); }
            }
        }
    }
}
