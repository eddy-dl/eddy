import { ThemeSettings, AccentColor } from "../themes/theme.slint";

export enum FileType { Video, Audio, Image, Document, Archive, DiskImage, Program, Folder, Other }

// Rounded tile with the file type's Material Symbols (rounded, filled) icon. Each
// type has its own colour, with a faint tint of it behind the glyph. With the Greyscale accent every type
// uses the accent's grey instead, like the settings sidebar icons.
export component FileTypeIcon inherits Rectangle {
    in property <FileType> file_type;
    // Stopped downloads; the card sets the tile's opacity from this.
    in property <bool> muted: false;

    out property <color> type_color: ThemeSettings.accent == AccentColor.Greyscale ? ThemeSettings.primary_accent
        : root.file_type == FileType.Video ? #E07A5F
        : root.file_type == FileType.Audio ? #9C89B8
        : root.file_type == FileType.Image ? #81B29A
        : root.file_type == FileType.Document ? #5B8DEF
        : root.file_type == FileType.Archive ? #E0A85C
        : root.file_type == FileType.DiskImage ? #7E8CE0
        : root.file_type == FileType.Program ? #8D99AE
        : root.file_type == FileType.Folder ? #E9B949
        : #9E9E9E;

    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.type_color.transparentize(ThemeSettings.is_dark ? 80% : 85%);

    // Material Symbols (rounded, filled) for each type.
    Image {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.type_color;
        source: root.file_type == FileType.Video ? @image-url("../icons/rounded/filled/movie.svg")
            : root.file_type == FileType.Audio ? @image-url("../icons/rounded/filled/music_note.svg")
            : root.file_type == FileType.Image ? @image-url("../icons/rounded/filled/image.svg")
            : root.file_type == FileType.Document ? @image-url("../icons/rounded/filled/description.svg")
            : root.file_type == FileType.Archive ? @image-url("../icons/rounded/filled/folder_zip.svg")
            : root.file_type == FileType.DiskImage ? @image-url("../icons/rounded/filled/album.svg")
            : root.file_type == FileType.Program ? @image-url("../icons/rounded/filled/apps.svg")
            : root.file_type == FileType.Folder ? @image-url("../icons/rounded/filled/folder.svg")
            : @image-url("../icons/rounded/filled/draft.svg");
    }
}
