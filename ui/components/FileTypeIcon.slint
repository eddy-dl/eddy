import { ThemeSettings, AccentColor } from "../themes/theme.slint";

export enum FileType { Video, Audio, Image, Document, Archive, DiskImage, Torrent, Program, Other }

// Rounded tile with a stroked glyph for the file's type, in the same 24-unit,
// 2px round-capped style as the nav icons. Each type has its own colour, with
// a faint tint of it behind the glyph. With the Greyscale accent every type
// uses the accent's grey instead, like the settings sidebar icons.
export component FileTypeIcon inherits Rectangle {
    in property <FileType> file_type;
    // Stopped downloads; the card sets the tile's opacity from this.
    in property <bool> muted: false;

    out property <color> type_color: ThemeSettings.accent == AccentColor.Greyscale ? ThemeSettings.primary_accent
        : root.file_type == FileType.Video ? #E07A5F
        : root.file_type == FileType.Audio ? #9C89B8
        : root.file_type == FileType.Image ? #81B29A
        : root.file_type == FileType.Document ? #5B8DEF
        : root.file_type == FileType.Archive ? #E0A85C
        : root.file_type == FileType.DiskImage ? #7E8CE0
        : root.file_type == FileType.Torrent ? #3DB2A6
        : root.file_type == FileType.Program ? #8D99AE
        : #9E9E9E;

    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.type_color.transparentize(ThemeSettings.is_dark ? 80% : 85%);

    Path {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.type_color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands:
            // Screen with a play triangle.
            root.file_type == FileType.Video ? "M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2Z M10.5 9.5l4 2.5l-4 2.5Z"
            // Two beamed notes.
            : root.file_type == FileType.Audio ? "M9 17V6l10 -2v11 M3 17a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M13 15a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"
            // Picture: frame, sun, hills.
            : root.file_type == FileType.Image ? "M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2Z M4 16l4.5 -4.5l4.5 4.5l2.5 -2.5l4.5 4.5 M14 8.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0"
            // Page with a folded corner and text lines.
            : root.file_type == FileType.Document ? "M14 3H7a2 2 0 0 0 -2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2V8Z M14 3v3.5a1.5 1.5 0 0 0 1.5 1.5H19 M9 13h6 M9 17h4"
            // Storage box with a lid and handle.
            : root.file_type == FileType.Archive ? "M3 6a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1Z M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2V9 M10 13h4"
            // Disc: outer ring, a shine arc, and the centre hole.
            : root.file_type == FileType.DiskImage ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M6.5 12a5.5 5.5 0 0 1 5.5 -5.5 M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0"
            // Peers linked together.
            : root.file_type == FileType.Torrent ? "M4 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0 M15 6a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0 M15 18a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0 M8.7 10.8l6.6 -3.6 M8.7 13.2l6.6 3.6"
            // App grid.
            : root.file_type == FileType.Program ? "M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1Z M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1Z M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1Z M14 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1Z"
            // Plain page.
            : "M14 3H7a2 2 0 0 0 -2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2V8Z M14 3v3.5a1.5 1.5 0 0 0 1.5 1.5H19";
    }
}
