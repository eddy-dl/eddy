// One of the yt-dlp helper apps on Android (YTDLnis's packages).
export struct HelperPackage {
    key: string, // "python", "ffmpeg" or "deno"
    installed: string, // installed version, "" when it isn't
    latest: string, // newest release for this device, "" when unknown
    size: string, // the newest release's download size
    // 0 checking, 1 not installed, 2 installed, 3 update available,
    // 4 downloading, 5 downloaded (ready to install, Android), 6 no build
    // for this device, 7 couldn't check, 8 installing (desktop: unpacking)
    state: int,
    progress: float, // while downloading, 0..1
}

export global AppSettings {
    in-out property <bool> is_mobile: false;
    in-out property <bool> haptic_feedback: false;
    // Android: draw with the font picked for the phone (found as Eddy
    // opens, so it shows from the next start).
    in-out property <bool> system_font: false;
    // What the font in use is: "" (Eddy's own), a file name, or why there's
    // none.
    in property <string> system_font_status;
    // Settings → About.
    in property <string> app_version: "0.0.0";
    in property <string> slint_version: "1.18.1";
    callback open_url(string);
    in-out property <bool> bottom_navigation_bar: true;
    // Icon-only tab bar under the header instead of the bottom bar.
    in-out property <bool> top_navigation_bar: false;
    in property <string> current_download_path: "";
    // Shown when no download folder has been picked.
    in property <string> default_download_path: "Download/Eddy";
    // Android "All files access": downloads can go straight into any folder.
    // Without it, folders outside Download/ and Documents/ get the finished
    // files copied in.
    in property <bool> all_files_access: false;
    // UI language: "" follows the system, otherwise a bundled locale ("en", "fr").
    in-out property <string> language: "";

    callback preferences_changed();
    callback theme_changed();
    callback select_download_folder();
    // Opens Android's "All files access" screen for the app.
    callback request_all_files_access();
    // Re-reads `all_files_access` (the app came back to the front, maybe
    // from that screen).
    callback storage_access_check();

    // The cookies.txt Eddy uses for sites that need a login (yt-dlp, TikTok,
    // Instagram). `cookies_count` is 0 without one; `cookies_sites` lists a
    // few of its sites; `cookies_error` says why the last file was refused:
    // 0 it wasn't, 1 couldn't read it, 2 not a cookies.txt, 3 couldn't save it.
    // A cookies.txt or a cookie extension's JSON export is taken; tabs
    // turned into spaces on the way (pasting) are put back.
    // `cookies_text` is the saved file, which Settings → Downloads → Cookies
    // shows and edits.
    in property <int> cookies_count: 0;
    in property <string> cookies_sites: "";
    in property <int> cookies_error: 0;
    in property <string> cookies_text: "";
    // Settings → Downloads → Downloading: every download's defaults (see
    // Links' LinkOptions).
    in-out property <int> dl_speed_kbps: 0;
    in-out property <int> dl_connections: 16;
    in-out property <int> dl_ua_mode: 0;
    in-out property <string> dl_ua_custom: "";
    in-out property <bool> dl_category_folders: false;
    // A file already there: replace it (else the new one gets a free name).
    in-out property <bool> dl_replace_existing: false;
    // How many downloads run at once, 0 for no limit; the rest are queued.
    // Not a per-download option.
    in-out property <int> dl_max_concurrent: 3;

    // Settings → Downloads → Books: how a book is saved unless the preview
    // says otherwise.
    in-out property <bool> novel_author_notes: true;
    in-out property <bool> novel_images: true;
    in-out property <bool> novel_author_note_images: false;
    in-out property <bool> novel_small_images: false;

    // Settings → Advanced: the download cache (thumbnails, link info,
    // installers, temporary files). `cache_refresh` measures it; clearing is
    // off while downloads run (`downloads_running`), as some may be in use.
    in property <string> cache_size: "";
    in property <bool> cache_empty: true;
    in property <bool> cache_busy: false;
    in property <bool> downloads_running: false;
    callback cache_refresh();
    callback cache_clear();

    // Picks a cookies.txt and keeps a copy of it.
    callback cookies_add();
    // Keeps the text as the cookies (pasted or edited); empty removes them.
    callback cookies_save(string);
    callback cookies_remove();

    // yt-dlp and friends. Android: YTDLnis's helper apps, which Eddy never
    // installs itself: it downloads one when asked (after a confirmation)
    // and opens Android's installer. Desktop ("ytdlp", "ffmpeg", "deno"):
    // installed into Eddy's own folder, also only once confirmed.
    in property <[HelperPackage]> helper_packages;
    // Look for newer releases (the Downloads settings opened).
    callback helpers_check();
    // Download a package's APK, then open the installer.
    callback helper_download(string);
    // Open the installer for an APK that's already downloaded.
    callback helper_install(string);
    // Fired after `language` changes so the Rust side can switch translations.
    callback language_changed();
}
