import { FileType } from "../components/FileTypeIcon.slint";

// How a link gets downloaded.
export enum LinkBackend {
    Direct, // plain HTTP/FTP file, through aria2
    Torrent, // magnet or .torrent, through aria2's BitTorrent
    Media, // a page's video / audio / images, through an extractor (yt-dlp or a native one)
    Book, // a web novel from a reading site, saved as an EPUB
    Drive, // a Google Drive file, or a folder's files, through aria2
    Mega, // a MEGA file, or a folder's files: fetched through aria2, then decrypted
}

export enum ProbeState { Probing, Ready, Failed }

// "Download now" choice: each link's best way, or prefer one backend where
// a link supports it. Torrents always download as torrents.
export enum QuickBackend { Auto, Direct, Media }

// One quality choice for a yt-dlp link.
export struct LinkFormat {
    selector: string, // passed to yt-dlp as -f
    label: string, // e.g. "1080p", "Audio only"
    detail: string, // e.g. "mp4 · ~245 MB"
}

// One of a download's several files: a torrent's, a post's / playlist's
// items, or a book's chapters.
export struct TorrentFile {
    index: int, // 1-based, as aria2's select-file counts
    path: string, // inside the torrent, e.g. "Show/S01E01.mkv"; an item's title
    // What its row shows ("" for `path`): a file's name inside its group.
    name: string,
    // The folder (a torrent's) or volume (a book's) it's in, shown as a
    // header that picks them all; "" when there are no groups.
    group: string,
    // Its group's ticks: 0 none, 1 some, 2 all.
    group_state: int,
    size: string, // formatted
    selected: bool,
    // Media items: 1 video, 2 audio, 3 image (0 a torrent's file; 4 a
    // book's locked chapter, never saved), its thumbnail, and whether a
    // video is saved as just its audio.
    kind: int,
    thumbnail: image,
    as_audio: bool,
    // Its own quality (a key, or a bitrate "128" as audio; "" for the
    // preview's), and the ones it has (as video, and as audio), held to pick.
    quality: string,
    formats: [LinkFormat],
    audio_formats: [LinkFormat],
}

// How one download goes about it (the preview's options; Settings →
// Downloads → Downloading by default).
export struct LinkOptions {
    speed_kbps: int, // 0 = no limit
    connections: int, // 1–16
    ua_mode: int, // 0 = aria2's own, 1 = a browser's, 2 = ua_custom
    ua_custom: string,
    category: bool, // into a Video / Music / Documents… folder
}

// A link found in the Add links text, waiting for the user to look at it.
// The Rust side fills in the details as it checks the link.
export struct PendingLink {
    id: int,
    url: string,
    state: ProbeState,
    error: string, // why the check failed (state == Failed)
    // Suggested file name. For yt-dlp it has no extension: that depends on
    // the format picked.
    filename: string,
    file_type: FileType,
    // The category folder it goes in with "Category folders" on ("Books",
    // "Video"…; as audio it's "Music").
    category: string,
    size: string, // formatted, "" when unknown
    source: string, // host, e.g. "example.com"
    backends: [LinkBackend], // ways this link can be downloaded, best first
    formats: [LinkFormat], // yt-dlp qualities, best first
    files: [TorrentFile], // a torrent's files, once known; all selected at first
    files_selected: int, // how many of `files` are selected
    // The rows of the first and last selected ones (-1 when none are).
    files_first: int,
    files_last: int,
    files_audio: int, // of the selected ones, how many are saved as audio
    folder: string, // where it'll be saved, as shown to the user
    folder_uri: string, // a folder picked for this link; "" for the usual one
    // Media links (LinkBackend.Media):
    service: string, // the extractor, e.g. "yt-dlp", "TikTok"
    thumbnail: image, // empty when there's none
    media_kind: int, // 0 = not media, 1 = video, 2 = audio, 3 = image
    // Bitrates for saving as audio (selector: kbps, e.g. "128").
    audio_formats: [LinkFormat],
    // Books (LinkBackend.Book): how many chapters, how many of them locked
    // (paid early access, never saved), and the preview's starting options
    // (Settings → Downloads → Books).
    book_chapters: int,
    book_locked: int,
    // Its title on the site (the preview's Title field starts with it).
    book_title: string,
    book_notes: bool,
    book_images: bool,
    book_note_images: bool,
    book_small_images: bool,
    // Updates as parts of their own (Settings → Books' default).
    book_parts: bool,
    // Saved before (the download it was saved by; 0 if not): downloading
    // updates it. `book_new`: chapters added since.
    book_saved_id: int,
    book_new: int,
}

export global Links {
    // Links waiting for a decision, oldest first.
    // PLACEHOLDER: sample links so the pending button and preview can be
    // designed in the viewer; the Rust side replaces this with its own list.
    in property <[PendingLink]> pending: [
        { id: 1, url: "https://www.youtube.com/watch?v=aqz-KE-bpKQ", state: ProbeState.Ready, error: "",
          filename: "Big Buck Bunny 60fps 4K - Official Blender Foundation Short Film", file_type: FileType.Video,
          size: "~604 MB", source: "youtube.com", folder: "Download/Eddy", backends: [LinkBackend.Media, LinkBackend.Direct],
          formats: [
              { selector: "3840:2160", label: "2160p", detail: "3840×2160 · ~604 MB" },
              { selector: "1920:1080", label: "1080p", detail: "1920×1080 · ~186 MB" },
              { selector: "1280:720", label: "720p", detail: "1280×720 · ~92 MB" },
          ],
          service: "yt-dlp", media_kind: 1,
          audio_formats: [
              { selector: "320", label: "320 kbps", detail: "~24 MB" },
              { selector: "256", label: "256 kbps", detail: "~19 MB" },
              { selector: "192", label: "192 kbps", detail: "~14 MB" },
              { selector: "128", label: "128 kbps", detail: "~9.6 MB" },
          ] },
        { id: 2, url: "https://releases.ubuntu.com/24.04/ubuntu-24.04-desktop-amd64.iso", state: ProbeState.Probing, error: "",
          filename: "ubuntu-24.04-desktop-amd64.iso", file_type: FileType.DiskImage,
          size: "", source: "releases.ubuntu.com", folder: "Download/Eddy", backends: [LinkBackend.Direct], formats: [] },
        { id: 3, url: "https://example.com/missing.zip", state: ProbeState.Failed, error: "404 Not Found",
          filename: "missing.zip", file_type: FileType.Archive,
          size: "", source: "example.com", folder: "Download/Eddy", backends: [LinkBackend.Direct], formats: [] },
        { id: 4, url: "https://webtorrent.io/torrents/sintel.torrent", state: ProbeState.Ready, error: "",
          filename: "Sintel", file_type: FileType.Folder,
          size: "129 MB", source: "webtorrent.io", folder: "Download/Eddy", backends: [LinkBackend.Torrent, LinkBackend.Direct], formats: [],
          files: [
              { index: 1, path: "Sintel/Sintel.mp4", size: "123 MB", selected: true },
              { index: 2, path: "Sintel/Sintel.en.srt", size: "1.6 KB", selected: true },
              { index: 3, path: "Sintel/Sintel.de.srt", size: "1.6 KB", selected: false },
              { index: 4, path: "Sintel/poster.jpg", size: "45 KB", selected: true },
          ],
          files_selected: 3 },
    ];

    // Whether yt-dlp can be offered at all on this device.
    in property <bool> ytdlp_available: true;

    // Find the links in some text and add them to `pending`.
    // The text, and whether its links may have spaces in them.
    callback process_text(string, bool);
    // Download a pending link (and drop it from `pending`). `format` is a
    // LinkFormat selector for yt-dlp, otherwise "".
    callback start(id: int, backend: LinkBackend, format: string, filename: string, options: LinkOptions);
    // Open a page in Eddy's browser; the download clicked there starts, as
    // `filename` ("" for the site's name) with `options`.
    callback open_browser(id: int, filename: string, options: LinkOptions);
    // Drop a pending link without downloading it.
    callback skip(id: int);
    // Pick a different folder for one link (it starts out with the usual one).
    callback pick_folder(id: int);
    // Select or unselect one of a torrent link's files (by TorrentFile.index).
    callback toggle_file(id: int, index: int);
    // Select or unselect all of a torrent link's files.
    callback select_all_files(id: int, selected: bool);
    // Select or unselect every file in a group (a folder, a volume).
    callback select_group(id: int, group: string, selected: bool);
    // Select the files from one row to another (both included), and no
    // others.
    callback select_range(id: int, first: int, last: int);
    // A video item saved as just its audio, or not; every item at once.
    callback toggle_audio(id: int, index: int);
    callback set_all_audio(id: int, audio: bool);
    // The preview's quality and bitrate (the items' sizes follow them), and
    // one item's own ("" to follow the preview's again).
    callback choose_quality(id: int, video: string, audio: string);
    callback set_item_quality(id: int, index: int, quality: string);
    // Download every pending link with the given choice, each as soon as
    // its check is done (failed ones stay pending).
    callback quick_download(QuickBackend);
    // Re-read the pending links saved by the share popup.
    callback sync();
}
