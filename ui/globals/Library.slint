// The Books page: every book saved, one row each however many files
// (parts) it came as. The Rust side fills `books` (see library.rs).

export struct BookRow {
    key: string, // "<site>:<id>", what `save_again` and `remove` take
    title: string,
    author: string, // "" when unknown
    site: string, // e.g. "Royal Road"
    size: string, // its files together, e.g. "2.4 MB"; "" when none
    chapters: int, // the book's chapters when it was last saved
    cover: image, // empty when none was kept
    // Its downloads, all deleted: shown struck out, to save again or remove.
    deleted: bool,
    // The download the row's buttons act on (its first file), -1 if deleted.
    download_id: int,
    checking: bool, // checking for new chapters
    // Parts whose files were deleted, e.g. "2, 3", and how many.
    missing_parts: string,
    missing_count: int,
}

export global Library {
    // PLACEHOLDER: sample books so the page can be designed in the viewer;
    // the Rust side replaces them.
    in property <[BookRow]> books: [
        // A drawn cover (an SVG, small in the app), to see how one looks.
        { key: "royalroad:1", title: "Mother of Learning", author: "nobody103", site: "Royal Road", size: "3.1 MB", chapters: 108, download_id: 1,
          cover: @image-url("sample-cover.svg") },
        { key: "ranobes:2", title: "Salvos (A Monster Evolution LitRPG)", author: "MelasD", site: "Ranobes", size: "14.8 MB", chapters: 812, download_id: 2, checking: true,
          missing_parts: "2", missing_count: 1 },
        { key: "ao3:3", title: "The Last Ship Out of Somewhere Very Far Away", author: "", site: "AO3", chapters: 24, deleted: true, download_id: -1 },
    ];
    // Opens the preview for the book's link, to save it again.
    callback save_again(string);
    // Takes a deleted book off the page.
    callback remove(string);
}
