export { DownloadItem, DownloadState, FileType } from "components/DownloadCards.slint";
export { SelectionAction } from "components/SelectionActions.slint";
export { DownloadInfo, InfoRow } from "components/DownloadInfoSheet.slint";
export { ItemAction } from "components/DownloadOptionsSheet.slint";
export { FolderFiles, FolderFile } from "components/FolderFilesSheet.slint";
export { ChooseFiles, ChoiceFile } from "components/ChooseFilesSheet.slint";

// The Android share popup's window. Exported before DownloaderApp so the
// viewer (which shows the last component) still opens the main app.
export { PreviewApp } from "popup.slint";
export { FolderBrowser } from "globals/FolderBrowser.slint";
import { SettingsLayout } from "settings/SettingsCard.slint";
export { SettingsLayout }
export { Links, LinkBackend, LinkFormat, LinkOptions, PendingLink, ProbeState, QuickBackend, TorrentFile } from "globals/Links.slint";

export component DownloaderApp inherits Window {
    title: "Eddy";
    // Material's Roboto, or the phone's own font (see ThemeSettings).
    default-font-family: ThemeSettings.font_family;
    background: ThemeSettings.background;
    animate background { duration: ThemeSettings.fade; easing: ease-in-out; }
    preferred-width: 420px;
    preferred-height: 850px;

    in-out property <int> active_tab: 0;
    in-out property <bool> is_landscape: false;
    in-out property <bool> is_mobile_landscape: false;
    in-out property <bool> menu_open: false;
    in-out property <bool> fab_open: false;
    // Sort & filter sheet for the active tab, opened by tapping its nav button again.
    in-out property <bool> options_open: false;
    // Add links sheet (from the FAB menu). Its text is kept when it's
    // dismissed, so a stray tap outside doesn't lose a long paste.
    in-out property <bool> add_links_open: false;
    property <string> add_links_text;
    // Preview of the first pending link, from the pending-links button.
    in-out property <bool> preview_open: false;
    // The last pending link was dealt with: nothing left to preview.
    private property <int> pending_count: Links.pending.length;
    changed pending_count => {
        if (self.pending_count == 0 && self.preview_open) {
            root.close_sheets();
        }
    }
    // Closing a sheet with a text field in it would leave focus nowhere,
    // and Back would then close the app; hand it back to back_scope.
    function close_sheets() {
        root.add_links_open = false;
        root.preview_open = false;
        back_scope.focus();
    }

    // PLACEHOLDER: sample items covering every file type so the cards can be
    // designed before the Rust side fills these lists. Reset each to [] (or
    // just set them from Rust) once real downloads are wired up.
    // Downloading holds the active items followed by the queued ones.
    in property <[DownloadItem]> downloading_items: [
        { id: 1, filename: "Big.Buck.Bunny.2008.1080p.mkv", file_type: FileType.Video, state: DownloadState.Active, progress: 0.42, downloaded: "512 MB", size: "1.2 GB", speed: "2.4 MB/s", eta: "4m 48s", date: "", url: "https://example.com/files/Big.Buck.Bunny.2008.1080p.mkv", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 2, filename: "lofi-beats-vol3.flac", file_type: FileType.Audio, state: DownloadState.Active, progress: 0.78, downloaded: "41 MB", size: "52 MB", speed: "860 KB/s", eta: "13s", date: "", url: "https://example.com/files/lofi-beats-vol3.flac", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 3, filename: "IMG_20261012_184522.jpg", file_type: FileType.Image, state: DownloadState.Active, progress: 0.9, downloaded: "4.3 MB", size: "4.8 MB", speed: "1.1 MB/s", eta: "1s", date: "", url: "https://example.com/files/IMG_20261012_184522.jpg", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 4, filename: "Annual_Report_2025.pdf", file_type: FileType.Document, state: DownloadState.Active, progress: 0.25, downloaded: "0.9 MB", size: "3.4 MB", speed: "320 KB/s", eta: "8s", date: "", url: "https://example.com/files/Annual_Report_2025.pdf", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 5, filename: "wallpapers-pack.zip", file_type: FileType.Archive, state: DownloadState.Active, progress: 0.61, downloaded: "525 MB", size: "860 MB", speed: "5.2 MB/s", eta: "1m 4s", date: "", url: "https://example.com/files/wallpapers-pack.zip", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 6, filename: "ubuntu-24.04-desktop-amd64.iso", file_type: FileType.DiskImage, state: DownloadState.Active, progress: 0.15, downloaded: "870 MB", size: "5.8 GB", speed: "6.1 MB/s", eta: "13m 30s", date: "", url: "https://example.com/files/ubuntu-24.04-desktop-amd64.iso", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 7, filename: "Sintel (2010) [4K]", file_type: FileType.Folder, state: DownloadState.Queued, progress: 0.0, downloaded: "0 B", size: "4.2 GB", speed: "", eta: "", date: "Oct 20", url: "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel", backend: LinkBackend.Torrent, folder: "Download/Eddy" },
        { id: 8, filename: "eddy-setup-0.2.0.exe", file_type: FileType.Program, state: DownloadState.Queued, progress: 0.0, downloaded: "0 B", size: "94 MB", speed: "", eta: "", date: "Oct 20", url: "https://example.com/files/eddy-setup-0.2.0.exe", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 9, filename: "firmware-v3.bin", file_type: FileType.Other, state: DownloadState.Queued, progress: 0.0, downloaded: "0 B", size: "16 MB", speed: "", eta: "", date: "Oct 19", url: "https://example.com/files/firmware-v3.bin", backend: LinkBackend.Direct, folder: "Download/Eddy" },
    ];
    in property <[DownloadItem]> stopped_items: [
        { id: 11, filename: "Big.Buck.Bunny.2008.1080p.mkv", file_type: FileType.Video, state: DownloadState.Paused, progress: 0.63, downloaded: "0.8 GB", size: "1.2 GB", speed: "", eta: "", date: "", url: "https://example.com/files/Big.Buck.Bunny.2008.1080p.mkv", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 14, filename: "Annual_Report_2025.pdf", file_type: FileType.Document, state: DownloadState.Paused, progress: 0.48, downloaded: "1.6 MB", size: "3.4 MB", speed: "", eta: "", date: "", url: "https://example.com/files/Annual_Report_2025.pdf", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 17, filename: "Sintel (2010) [4K]", file_type: FileType.Folder, state: DownloadState.Paused, progress: 0.33, downloaded: "1.4 GB", size: "4.2 GB", speed: "", eta: "", date: "", url: "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel", backend: LinkBackend.Torrent, folder: "Download/Eddy" },
        { id: 12, filename: "lofi-beats-vol3.flac", file_type: FileType.Audio, state: DownloadState.Failed, progress: 0.27, downloaded: "14.0 MB", size: "52 MB", speed: "", eta: "", date: "", url: "https://example.com/files/lofi-beats-vol3.flac", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 15, filename: "wallpapers-pack.zip", file_type: FileType.Archive, state: DownloadState.Failed, progress: 0.81, downloaded: "696.6 MB", size: "860 MB", speed: "", eta: "", date: "", url: "https://example.com/files/wallpapers-pack.zip", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 18, filename: "eddy-setup-0.2.0.exe", file_type: FileType.Program, state: DownloadState.Failed, progress: 0.05, downloaded: "4.7 MB", size: "94 MB", speed: "", eta: "", date: "", url: "https://example.com/files/eddy-setup-0.2.0.exe", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 13, filename: "IMG_20261012_184522.jpg", file_type: FileType.Image, state: DownloadState.Cancelled, progress: 0.4, downloaded: "1.9 MB", size: "4.8 MB", speed: "", eta: "", date: "", url: "https://example.com/files/IMG_20261012_184522.jpg", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 16, filename: "ubuntu-24.04-desktop-amd64.iso", file_type: FileType.DiskImage, state: DownloadState.Cancelled, progress: 0.12, downloaded: "0.7 GB", size: "5.8 GB", speed: "", eta: "", date: "", url: "https://example.com/files/ubuntu-24.04-desktop-amd64.iso", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 19, filename: "firmware-v3.bin", file_type: FileType.Other, state: DownloadState.Cancelled, progress: 0.7, downloaded: "11.2 MB", size: "16 MB", speed: "", eta: "", date: "", url: "https://example.com/files/firmware-v3.bin", backend: LinkBackend.Direct, folder: "Download/Eddy" },
    ];
    in property <[DownloadItem]> completed_items: [
        { id: 21, filename: "Big.Buck.Bunny.2008.1080p.mkv", file_type: FileType.Video, state: DownloadState.Completed, progress: 1.0, downloaded: "1.2 GB", size: "1.2 GB", speed: "", eta: "", date: "Oct 18", url: "https://example.com/files/Big.Buck.Bunny.2008.1080p.mkv", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 22, filename: "lofi-beats-vol3.flac", file_type: FileType.Audio, state: DownloadState.Completed, progress: 1.0, downloaded: "52 MB", size: "52 MB", speed: "", eta: "", date: "Oct 17", url: "https://example.com/files/lofi-beats-vol3.flac", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 23, filename: "IMG_20261012_184522.jpg", file_type: FileType.Image, state: DownloadState.Completed, progress: 1.0, downloaded: "4.8 MB", size: "4.8 MB", speed: "", eta: "", date: "Oct 15", url: "https://example.com/files/IMG_20261012_184522.jpg", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 24, filename: "Annual_Report_2025.pdf", file_type: FileType.Document, state: DownloadState.Completed, progress: 1.0, downloaded: "3.4 MB", size: "3.4 MB", speed: "", eta: "", date: "Oct 12", url: "https://example.com/files/Annual_Report_2025.pdf", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 25, filename: "wallpapers-pack.zip", file_type: FileType.Archive, state: DownloadState.Completed, progress: 1.0, downloaded: "860 MB", size: "860 MB", speed: "", eta: "", date: "Oct 9", url: "https://example.com/files/wallpapers-pack.zip", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 26, filename: "ubuntu-24.04-desktop-amd64.iso", file_type: FileType.DiskImage, state: DownloadState.Completed, progress: 1.0, downloaded: "5.8 GB", size: "5.8 GB", speed: "", eta: "", date: "Oct 6", url: "https://example.com/files/ubuntu-24.04-desktop-amd64.iso", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 27, filename: "Sintel (2010) [4K]", file_type: FileType.Folder, state: DownloadState.Completed, progress: 1.0, downloaded: "4.2 GB", size: "4.2 GB", speed: "", eta: "", date: "Oct 4", url: "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel", backend: LinkBackend.Torrent, folder: "Download/Eddy" },
        { id: 28, filename: "eddy-setup-0.2.0.exe", file_type: FileType.Program, state: DownloadState.Completed, progress: 1.0, downloaded: "94 MB", size: "94 MB", speed: "", eta: "", date: "Sep 28", url: "https://example.com/files/eddy-setup-0.2.0.exe", backend: LinkBackend.Direct, folder: "Download/Eddy" },
        { id: 29, filename: "firmware-v3.bin", file_type: FileType.Other, state: DownloadState.Completed, progress: 1.0, downloaded: "16 MB", size: "16 MB", speed: "", eta: "", date: "Sep 21", url: "https://example.com/files/firmware-v3.bin", backend: LinkBackend.Direct, folder: "Download/Eddy" },
    ];

    // The first item is enough: queued items always come after the active ones.
    out property <bool> has_active_downloads: root.downloading_items.length > 0 && root.downloading_items[0].state == DownloadState.Active;
    out property <ColorScheme> system-theme: Palette.color-scheme;
    out property <brush> system-accent: Palette.accent-background;

    in-out property <bool> show_appearance: false;
    in-out property <bool> show_about: false;
    in-out property <bool> show_settings: false;

    // Space the bottom bar takes (or just the inset when the top bar is used).
    private property <length> bottom_bar_height: AppSettings.top_navigation_bar ? root.safe-area-insets.bottom : 80px + root.safe-area-insets.bottom;

    // True while a download list is moving; the bottom bar and FAB go see-through
    // so the cards under them stay visible.
    private property <bool> list_scrolling: false;
    // The scrollbar hint shows while scrolling and fades a while after.
    private property <bool> scrollbar_shown: false;
    function list_scrolled() {
        root.list_scrolling = true;
        root.scrollbar_shown = true;
        // restart() is a no-op on a stopped timer, so start it first;
        // restart() then pushes the deadline back while scrolling continues.
        scroll_idle.start();
        scroll_idle.restart();
        scrollbar_idle.start();
        scrollbar_idle.restart();
    }

    scrollbar_idle := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.stop();
            root.scrollbar_shown = false;
        }
    }

    // --- Selection ---
    // Long-press a card to start selecting; taps then toggle cards. Each row
    // keeps its own selection marker (not the item data, so selecting never
    // rewrites the list): a row is selected when its marker equals
    // `selection_gen`, so bumping the generation deselects every row at once.
    // Rust learns about changes through `selection_changed`.
    out property <bool> selection_mode: false;
    out property <int> selection_gen: 1;
    out property <int> selected_count: 0;
    // Select all / Invert: every row's marker reads the other way round
    // (Rust works out which items that selects).
    private property <bool> selection_inverted: false;
    // Stopped's Cancel (for paused ones) lives in the ⋮ menu: the header
    // holds three actions (SelectionActionBar).
    private property <bool> selection_cancel_overflows: root.active_tab == 1 && root.selected_paused > 0;
    // How many selected items are in each state, so the header only offers
    // actions that apply (see SelectionActionBar).
    private property <int> selected_running: 0; // active or queued
    private property <int> selected_paused: 0;
    private property <int> selected_ended: 0; // failed or cancelled

    // (tab, item id, now selected). Tab: 0 = Downloading, 1 = Stopped, 2 = Completed.
    callback selection_changed(int, int, bool);
    // Fired when everything is deselected at once (Back, ×, tab switch).
    callback selection_cleared();
    // Selects every item in a tab, or with `invert`, the ones not selected.
    // Returns the counts: [selected, running, paused, ended].
    callback selection_all(tab: int, invert: bool) -> [int];
    // Do something with every selected item in a tab (the ones reported
    // through selection_changed). `delete_files` only matters for Delete.
    // Selection is cleared afterwards.
    callback selection_action(tab: int, action: SelectionAction, delete_files: bool);

    // Delete asks first. For the selection, or (from a download's options)
    // one item: delete_target is its id, -1 for the selection.
    in-out property <bool> delete_confirm_open: false;
    private property <bool> delete_files: false;
    private property <int> delete_target: -1;

    function run_selection_action(action: SelectionAction) {
        if (action == SelectionAction.Delete) {
            root.delete_files = false;
            root.delete_target = -1;
            root.delete_confirm_open = true;
        } else if (action == SelectionAction.Info) {
            // The selection stays, to act on after reading.
            root.selection_action(root.active_tab, action, false);
        } else {
            root.selection_action(root.active_tab, action, false);
            root.clear_selection();
        }
    }

    // Called by a row after it flips its own marker.
    function selection_updated(tab: int, id: int, state: DownloadState, now_selected: bool) {
        let step = now_selected ? 1 : -1;
        root.selected_count += step;
        if (state == DownloadState.Active || state == DownloadState.Queued) {
            root.selected_running += step;
        } else if (state == DownloadState.Paused) {
            root.selected_paused += step;
        } else if (state == DownloadState.Failed || state == DownloadState.Cancelled) {
            root.selected_ended += step;
        }
        root.selection_changed(tab, id, now_selected);
        // Deselecting the last item leaves selection mode.
        if (root.selected_count <= 0) {
            root.clear_selection();
        }
    }
    function select_all(invert: bool) {
        if (invert) {
            root.selection_inverted = !root.selection_inverted;
        } else {
            // Every marker cleared, then read the other way round: all selected.
            root.selection_gen += 1;
            root.selection_inverted = true;
        }
        let counts = root.selection_all(root.active_tab, invert);
        root.selected_count = counts[0];
        root.selected_running = counts[1];
        root.selected_paused = counts[2];
        root.selected_ended = counts[3];
        if (root.selected_count <= 0) {
            root.clear_selection();
        }
    }
    function clear_selection() {
        if (root.selection_mode) {
            root.selection_cleared();
        }
        root.selection_inverted = false;
        root.selection_gen += 1;
        root.selected_count = 0;
        root.selected_running = 0;
        root.selected_paused = 0;
        root.selected_ended = 0;
        root.selection_mode = false;
    }

    // Room below the last card: clear of the bottom bar and the + button.
    private property <length> list_bottom_padding: root.bottom_bar_height + 64px + 32px;

    // A tab's sort & filter sheet goes with it (the bar isn't covered by its
    // dimming, so tapping or swiping to another tab doesn't dismiss it).
    changed active_tab => {
        root.clear_selection();
        root.options_open = false;
    }

    // Fires once the list has stopped moving for a moment.
    scroll_idle := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.stop();
            root.list_scrolling = false;
        }
    }

    // Nav buttons: a tap switches tabs; a tap on the tab already shown opens
    // its sort & filter options instead (or closes them).
    function tab_clicked(tab: int) {
        root.tab_before_tap = root.active_tab;
        root.options_before_tap = root.options_open;
        tap_guard.start();
        tap_guard.restart();
        if (root.options_open) {
            // Open: any tab, the one it's for too, puts it away.
            root.options_open = false;
            root.active_tab = tab;
        } else if (root.active_tab == tab) {
            // After a dismissal by dragging, it opens from its place again.
            list_options_sheet.reset_drag();
            root.options_open = true;
        } else {
            root.active_tab = tab;
        }
    }

    // Undoing a nav tap made by the Android home gesture. Slint 1.18 turns the
    // touch cancel the system sends when it takes the gesture over into an
    // ordinary release, so starting a home swipe on the bottom bar "taps" the
    // button under the finger. The window loses focus right after, so a tap
    // followed quickly by losing focus is put back (see back_scope).
    private property <int> tab_before_tap: 0;
    private property <bool> options_before_tap: false;
    tap_guard := Timer {
        interval: 500ms;
        running: false;
        triggered => { self.stop(); }
    }
    function window_deactivated() {
        if (tap_guard.running) {
            tap_guard.stop();
            root.active_tab = root.tab_before_tap;
            root.options_open = root.options_before_tap;
        }
    }

    // Height of the tinted upper section (status bar area, header, top tabs).
    private property <length> upper_section_height: Math.max(24px, root.safe-area-insets.top) + 48px + 48px;

    function preferences_changed() { AppSettings.preferences_changed(); }
    public function update_orientation() {
        root.is_landscape = root.width > root.height;
        if root.is_landscape {
            root.is_mobile_landscape = root.height < 412px;
        } else {
            root.is_mobile_landscape = false;
        }
    }
    function update_system_theme() { ThemeSettings.system_is_dark = Palette.color-scheme == ColorScheme.dark; }

    changed system-theme => { update_system_theme(); AppSettings.theme_changed(); }
    changed system-accent => { AppSettings.theme_changed(); }
    changed height => { root.update_orientation(); }
    changed width => { root.update_orientation(); }
    changed show_settings => { back_scope.focus(); }
    init => { update_orientation(); update_system_theme(); back_scope.focus(); }

    callback add_from_txt_clicked();
    callback open_menu();
    // Do something to one download (see ItemAction); `value` is the new name
    // for Rename, the new link for RefreshLink, "files" for a Delete that
    // also removes the files, otherwise "".
    callback download_action(id: int, action: ItemAction, value: string);
    // New options for one download (from its options sheet).
    callback download_options_changed(id: int, options: LinkOptions);

    // Tapping an unfinished download shows its options.
    in-out property <bool> item_options_open: false;
    private property <DownloadItem> options_item;
    function open_item_options(item: DownloadItem) {
        root.options_item = item;
        options_sheet.reset();
        root.item_options_open = true;
    }
    function close_item_options() {
        root.item_options_open = false;
        // The rename / link field may have had focus; keep Back working.
        back_scope.focus();
    }

    // Single owner of keyboard focus. It wraps the whole UI so it is an
    // ancestor of anything that grabs focus (e.g. a ListView) and Back still
    // bubbles up to it, and it is never hidden or clipped, so Slint 1.18+ never
    // drops its focus. Rejecting Back lets Android close the app.
    back_scope := FocusScope {
        focus-lost(reason) => {
            if (reason == FocusReason.window-activation) {
                root.window_deactivated();
            }
        }
        // Back in front: pick up links shared to Eddy in the meantime.
        focus-gained(reason) => {
            if (reason == FocusReason.window-activation) {
                Links.sync();
                AppSettings.storage_access_check();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (FolderBrowser.open) {
                    FolderBrowser.cancel();
                    return accept;
                }
                if (root.show_settings) {
                    st_page.navigate_back();
                    return accept;
                }
                if (root.delete_confirm_open) {
                    root.delete_confirm_open = false;
                    return accept;
                }
                if (DownloadInfo.open) {
                    DownloadInfo.open = false;
                    return accept;
                }
                if (root.item_options_open) {
                    root.close_item_options();
                    return accept;
                }
                if (ChooseFiles.open) {
                    ChooseFiles.open = false;
                    return accept;
                }
                if (FolderFiles.open) {
                    FolderFiles.open = false;
                    return accept;
                }
                if (root.selection_mode) {
                    root.clear_selection();
                    return accept;
                }
                if (root.add_links_open || root.preview_open) {
                    root.close_sheets();
                    return accept;
                }
                if (root.menu_open || root.fab_open || root.options_open) {
                    root.menu_open = false;
                    root.fab_open = false;
                    root.options_open = false;
                    return accept;
                }
            }
            return reject;
        }
        VerticalLayout {
            // With the top bar, the whole upper section (status bar area, header
            // and tabs) is tinted like the bottom bar.
            Rectangle {
                z: 1;
                background: AppSettings.top_navigation_bar ? ThemeSettings.surface : transparent;

                VerticalLayout {
                    padding-top: Math.max(24px, root.safe-area-insets.top);

                    HorizontalLayout {
                        height: 48px;
                        padding-left: Math.max(16px, root.safe-area-insets.left);
                        padding-right: Math.max(16px, root.safe-area-insets.right);
                        // The left part takes the spare width (space-between
                        // would share it out as gaps, putting the selection
                        // actions mid-header on a wide screen), so the actions
                        // sit at the right by the ⋮ on any screen.
                        HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            // Leaves selection mode (same as Back).
                            if root.selection_mode: ActionIcon {
                                label: @tr("Close");
                                icon: @image-url("icons/rounded/close.svg");
                                clicked => { root.clear_selection(); }
                            }

                            // The app's logo; the count while selecting.
                            if !root.selection_mode: VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    alignment: start;
                                    Wordmark { }
                                }
                            }
                            // MD3 title large.
                            if root.selection_mode: Text {
                                text: @tr("{n} selected" | "{n} selected" % root.selected_count);
                                font-size: 22px;
                                color: ThemeSettings.text_color;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.selection_mode: SelectionActionBar {
                            tab: root.active_tab;
                            running: root.selected_running;
                            paused: root.selected_paused;
                            ended: root.selected_ended;
                            count: root.selected_count;
                            action(action) => { root.run_selection_action(action); }
                        }

                        // Settings; while selecting, a menu of Select all and
                        // Invert.
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: ta_menu.pressed && !ta_menu.holding ? (AppSettings.top_navigation_bar ? ThemeSettings.background : ThemeSettings.surface) : transparent;
                            animate background { duration: 150ms; }

                            ta_menu := HoldTouchArea {
                                tapped => {
                                    if (root.selection_mode) {
                                        root.menu_open = !root.menu_open;
                                    } else {
                                        root.show_settings = true;
                                    }
                                }
                            }

                            Image {
                                source: root.selection_mode ? @image-url("icons/rounded/more_vert.svg") : @image-url("icons/rounded/settings.svg");
                                width: 24px;
                                height: 24px;
                                colorize: ThemeSettings.text_color;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Holding it names it, below it and kept to the
                            // screen's right edge.
                            HintBubble {
                                text: root.selection_mode ? @tr("More options") : @tr("Settings");
                                shown: ta_menu.holding;
                                x: parent.width - self.width;
                                y: parent.height + 8px;
                            }
                        }
                    }

                    if AppSettings.top_navigation_bar: TopNavBar {
                        active_tab: root.active_tab;
                        is_downloading: root.has_active_downloads;
                        tab_selected(tab) => { root.tab_clicked(tab); }
                    }
                }
            }

            // With the top bar, the list sits on a sheet whose rounded top
            // corners cut into the tinted section above, giving an "n" shape.
            Rectangle {
                vertical-stretch: 1;
                background: AppSettings.top_navigation_bar ? ThemeSettings.surface : transparent;

                Rectangle {
                    background: ThemeSettings.background;
                    border-top-left-radius: AppSettings.top_navigation_bar ? 16px : 0px;
                    border-top-right-radius: AppSettings.top_navigation_bar ? 16px : 0px;
                    clip: true;

                    // Swiping sideways on a navigation bar switches tabs, with the
                    // lists following the finger. (Swiping on the lists themselves
                    // isn't possible in Slint 1.18 without breaking their fling: a
                    // gesture handler around them delays every press by 100ms.)
                    swipe := Rectangle {
                        width: 100%;
                        height: 100%;
                        property <bool> following: TabSwipe.active;
                        // Past the first or last tab the strip only gives a little.
                        property <length> follow_offset: (TabSwipe.offset > 0 && root.active_tab == 0)
                            || (TabSwipe.offset < 0 && root.active_tab == 2)
                            ? TabSwipe.offset / 4 : TabSwipe.offset;

                        // A swipe just ended: past a quarter of the width switches.
                        property <int> releases: TabSwipe.releases;
                        changed releases => {
                            if (TabSwipe.released_offset > self.width / 4 && root.active_tab > 0) {
                                root.active_tab -= 1;
                            } else if (TabSwipe.released_offset < -self.width / 4 && root.active_tab < 2) {
                                root.active_tab += 1;
                            }
                        }

                        // The three lists side by side on one strip. It slides to the
                        // active tab and follows the finger while swiping.
                        Rectangle {
                            property <length> position: -root.active_tab * self.width;
                            animate position {
                                duration: 300ms;
                                easing: cubic-bezier(0.2, 0.0, 0, 1.0);
                            }
                            property <length> swipe_offset: 0px;
                            x: self.position + self.swipe_offset;
                            width: parent.width;
                            height: parent.height;

                            states [
                                swiping when swipe.following: {
                                    swipe_offset: swipe.follow_offset;
                                    out {
                                        animate swipe_offset {
                                            duration: 300ms;
                                            easing: cubic-bezier(0.2, 0.0, 0, 1.0);
                                        }
                                    }
                                }
                            ]

                            // Tab 0.
                            Rectangle {
                                x: 0 * parent.width;
                                width: parent.width;
                                height: parent.height;

                                flick_0 := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    content-height: layout_0.preferred-height;
                                    changed content-y => { root.list_scrolled(); }

                                    layout_0 := VerticalLayout {
                                        padding-left: Math.max(16px, root.safe-area-insets.left);
                                        padding-right: Math.max(16px, root.safe-area-insets.right);
                                        padding-top: 8px;
                                        padding-bottom: root.list_bottom_padding;
                                        spacing: 8px;

                                        for item[i] in root.downloading_items: row_0 := Rectangle {
                                            // This row's selection marker (see "Selection" above).
                                            property <int> selected_in: 0;
                                            property <bool> selected: root.selection_mode && ((self.selected_in == root.selection_gen) != root.selection_inverted);
                                            // Queued items follow the active ones; the first gets a section label.
                                            property <bool> queued: item.state == DownloadState.Queued;
                                            property <bool> first_queued: self.queued && (i == 0 || root.downloading_items[i - 1].state != DownloadState.Queued);
                                            property <length> label_height: self.first_queued ? 32px : 0px;
                                            height: self.label_height + (self.queued ? 68px : 84px);

                                            if row_0.first_queued: ListHeader {
                                                text: @tr("Queued");
                                                x: 4px;
                                                y: 4px;
                                                height: 28px;
                                            }
                                            if !row_0.queued: DownloadingCard {
                                                y: row_0.label_height;
                                                item: item;
                                                selected: row_0.selected;
                                                clicked => {
                                                    if (root.selection_mode) {
                                                        row_0.selected_in = row_0.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                        root.selection_updated(0, item.id, item.state, row_0.selected);
                                                    } else {
                                                        root.open_item_options(item);
                                                    }
                                                }
                                                long_pressed => {
                                                    root.selection_mode = true;
                                                    row_0.selected_in = row_0.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                    root.selection_updated(0, item.id, item.state, row_0.selected);
                                                }
                                            }
                                            if row_0.queued: QueuedCard {
                                                y: row_0.label_height;
                                                item: item;
                                                selected: row_0.selected;
                                                clicked => {
                                                    if (root.selection_mode) {
                                                        row_0.selected_in = row_0.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                        root.selection_updated(0, item.id, item.state, row_0.selected);
                                                    } else {
                                                        root.open_item_options(item);
                                                    }
                                                }
                                                long_pressed => {
                                                    root.selection_mode = true;
                                                    row_0.selected_in = row_0.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                    root.selection_updated(0, item.id, item.state, row_0.selected);
                                                }
                                            }
                                        }
                                    }
                                }

                                hint_0 := ScrollHint {
                                    content_y <=> flick_0.content-y;
                                    content_height: flick_0.content-height;
                                    viewport_height: flick_0.height;
                                    shown: root.scrollbar_shown && root.active_tab == 0;
                                    bottom_inset: root.bottom_bar_height;
                                    x: parent.width - self.width - 3px;
                                }
                            }

                            // Tab 1.
                            Rectangle {
                                x: 1 * parent.width;
                                width: parent.width;
                                height: parent.height;

                                flick_1 := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    content-height: layout_1.preferred-height;
                                    changed content-y => { root.list_scrolled(); }

                                    layout_1 := VerticalLayout {
                                        padding-left: Math.max(16px, root.safe-area-insets.left);
                                        padding-right: Math.max(16px, root.safe-area-insets.right);
                                        padding-top: 8px;
                                        padding-bottom: root.list_bottom_padding;
                                        spacing: 8px;

                                        for item[i] in root.stopped_items: row_1 := Rectangle {
                                            // This row's selection marker (see "Selection" above).
                                            property <int> selected_in: 0;
                                            property <bool> selected: root.selection_mode && ((self.selected_in == root.selection_gen) != root.selection_inverted);
                                            // Grouped by state (Paused, Failed, Cancelled); the first of each group gets a label.
                                            property <bool> first_of_state: i == 0 || root.stopped_items[i - 1].state != item.state;
                                            property <length> label_height: self.first_of_state ? 32px : 0px;
                                            height: self.label_height + 84px;

                                            if row_1.first_of_state: ListHeader {
                                                text: item.state == DownloadState.Failed ? @tr("Failed")
                                                    : item.state == DownloadState.Cancelled ? @tr("Cancelled")
                                                    : @tr("Paused");
                                                x: 4px;
                                                y: 4px;
                                                height: 28px;
                                            }
                                            StoppedCard {
                                                y: row_1.label_height;
                                                item: item;
                                                selected: row_1.selected;
                                                clicked => {
                                                    if (root.selection_mode) {
                                                        row_1.selected_in = row_1.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                        root.selection_updated(1, item.id, item.state, row_1.selected);
                                                    } else {
                                                        root.open_item_options(item);
                                                    }
                                                }
                                                long_pressed => {
                                                    root.selection_mode = true;
                                                    row_1.selected_in = row_1.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                    root.selection_updated(1, item.id, item.state, row_1.selected);
                                                }
                                            }
                                        }
                                    }
                                }

                                hint_1 := ScrollHint {
                                    content_y <=> flick_1.content-y;
                                    content_height: flick_1.content-height;
                                    viewport_height: flick_1.height;
                                    shown: root.scrollbar_shown && root.active_tab == 1;
                                    bottom_inset: root.bottom_bar_height;
                                    x: parent.width - self.width - 3px;
                                }
                            }

                            // Tab 2.
                            Rectangle {
                                x: 2 * parent.width;
                                width: parent.width;
                                height: parent.height;

                                flick_2 := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    content-height: layout_2.preferred-height;
                                    changed content-y => { root.list_scrolled(); }

                                    layout_2 := VerticalLayout {
                                        padding-left: Math.max(16px, root.safe-area-insets.left);
                                        padding-right: Math.max(16px, root.safe-area-insets.right);
                                        padding-top: 8px;
                                        padding-bottom: root.list_bottom_padding;
                                        spacing: 8px;

                                        for item[i] in root.completed_items: row_2 := CompletedCard {
                                            // This row's selection marker (see "Selection" above).
                                            property <int> selected_in: 0;
                                            selected: root.selection_mode && ((self.selected_in == root.selection_gen) != root.selection_inverted);
                                            item: item;
                                            selecting: root.selection_mode;
                                            update_book => { root.download_action(item.id, ItemAction.UpdateBook, ""); }
                                            choose_chapters => { root.download_action(item.id, ItemAction.ChooseFiles, ""); }
                                                clicked => {
                                                    if (root.selection_mode) {
                                                        row_2.selected_in = row_2.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                        root.selection_updated(2, item.id, item.state, row_2.selected);
                                                    } else {
                                                        root.download_action(item.id, ItemAction.Open, "");
                                                    }
                                                }
                                                long_pressed => {
                                                    root.selection_mode = true;
                                                    row_2.selected_in = row_2.selected_in == root.selection_gen ? 0 : root.selection_gen;
                                                    root.selection_updated(2, item.id, item.state, row_2.selected);
                                                }
                                        }
                                    }
                                }

                                hint_2 := ScrollHint {
                                    content_y <=> flick_2.content-y;
                                    content_height: flick_2.content-height;
                                    viewport_height: flick_2.height;
                                    shown: root.scrollbar_shown && root.active_tab == 2;
                                    bottom_inset: root.bottom_bar_height;
                                    x: parent.width - self.width - 3px;
                                }
                            }
                        }
                    }

                    // Pending links: shows how many links are waiting to be looked
                    // at; tapping it previews the first.
                    Rectangle {
                        property <bool> shown: Links.pending.length > 0;
                        width: 56px;
                        height: 56px;
                        border-radius: 16px;
                        background: ThemeSettings.surface;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000030;

                        x: Math.max(16px, root.safe-area-insets.left);
                        // Level with the main FAB (both MD3's 56px).
                        y: parent.height - 56px - 16px - root.bottom_bar_height;

                        visible: self.opacity > 0;
                        opacity: !self.shown ? 0 : (ta_pending.pressed ? 0.8 : 1.0);
                        transform-scale: self.shown ? 1.0 : 0.6;
                        animate opacity, transform-scale { duration: 200ms; easing: ease-out-quad; }

                        states [
                            scrolling when self.shown && root.list_scrolling && !ta_pending.pressed: {
                                opacity: 0.4;
                            }
                        ]

                        ta_pending := TouchArea {
                            enabled: parent.shown;
                            clicked => { root.preview_open = true; }
                        }

                        // Chain link glyph, in the nav icons' stroked style.
                        Path {
                            width: 26px;
                            height: 26px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: ThemeSettings.primary_accent;
                            stroke-width: 2px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            fill: transparent;
                            commands: "M10 13a5 5 0 0 0 7.54 .54l3 -3a5 5 0 0 0 -7.07 -7.07l-1.72 1.71 M14 11a5 5 0 0 0 -7.54 -.54l-3 3a5 5 0 0 0 7.07 7.07l1.71 -1.71";
                        }

                        // Count badge on the top-right corner.
                        Rectangle {
                            property <string> label: Links.pending.length > 99 ? "99+" : Links.pending.length;
                            width: Math.max(22px, badge_text.preferred-width + 12px);
                            height: 22px;
                            border-radius: 11px;
                            x: parent.width - self.width + 6px;
                            y: -6px;
                            // MD3's error and on-error colours (badges).
                            background: ThemeSettings.is_dark ? #F2B8B5 : #B3261E;
                            border-width: 2px;
                            border-color: ThemeSettings.background;

                            badge_text := Text {
                                text: parent.label;
                                font-size: 11px;
                                font-weight: 700;
                                color: ThemeSettings.is_dark ? #601410 : #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // MD3 standard FAB: 56, 16 corners, a 24 icon; Material You's
                    // container colours (the second colour's, for a pair).
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 16px;
                        background: ThemeSettings.secondary_container;
                        animate background { duration: ThemeSettings.fade; easing: ease-in-out; }
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000040;

                        x: parent.width - self.width - Math.max(16px, root.safe-area-insets.right);
                        y: parent.height - self.height - 16px - root.bottom_bar_height;

                        ta_fab := TouchArea {
                            clicked => { root.fab_open = !root.fab_open; }
                        }

                        opacity: ta_fab.pressed ? 0.8 : 1.0;
                        drop-shadow-offset-y: ta_fab.pressed ? 2px : 4px;
                        animate opacity, drop-shadow-offset-y { duration: 150ms; }

                        states [
                            scrolling when root.list_scrolling && !ta_fab.pressed: {
                                opacity: 0.4;
                            }
                        ]

                        Image {
                            source: @image-url("icons/rounded/add.svg");
                            width: 24px;
                            height: 24px;
                            colorize: ThemeSettings.on_secondary_container;

                            // Centred in the FAB
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;

                            transform-rotation: root.fab_open ? 135deg : 0deg;
                            animate transform-rotation {
                                duration: 350ms;
                                easing: ease-in-out;
                            }
                        }
                    }
                }
            }

        }

        // Floats over the bottom of the list so cards can show through it.
        if !AppSettings.top_navigation_bar: Rectangle {
            x: 0px;
            y: root.height - self.height;
            width: root.width;
            height: 80px + root.safe-area-insets.bottom;
            background: ThemeSettings.surface;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000010;
            drop-shadow-offset-y: -2px;

            // Semi-transparent while the list moves, solid again the moment it
            // stops (no animation on the way back).
            states [
                scrolling when root.list_scrolling: {
                    background: ThemeSettings.surface.transparentize(65%);
                    drop-shadow-color: transparent;
                    in {
                        animate background, drop-shadow-color { duration: 150ms; }
                    }
                }
            ]

            TabSwipeArea {
                HorizontalLayout {
                    padding-bottom: root.safe-area-insets.bottom;
                    alignment: stretch;

                    BottomNavButton {
                        text: @tr("Downloading");
                        icon_type: 0;
                        is_active: root.active_tab == 0;
                        is_downloading: root.has_active_downloads;
                        clicked => { root.tab_clicked(0); }
                    }

                    BottomNavButton {
                        text: @tr("Stopped");
                        icon_type: 1;
                        is_active: root.active_tab == 1;
                        clicked => { root.tab_clicked(1); }
                    }

                    BottomNavButton {
                        text: @tr("Completed");
                        icon_type: 2;
                        is_active: root.active_tab == 2;
                        clicked => { root.tab_clicked(2); }
                    }
                }
            }
        }

        // --- ANIMATED OVERLAYS ---

        // Sort & filter sheet, attached to the bar it was opened from: it sits
        // on the bottom bar (or hangs from the top section with the top bar)
        // and slides out of it. The dimming stops at the bar, which stays as
        // it is, and hides the sheet as it slides back in.
        Rectangle {
            z: 90;
            width: 100%;
            y: AppSettings.top_navigation_bar ? root.upper_section_height : 0px;
            height: AppSettings.top_navigation_bar ? root.height - root.upper_section_height : root.height - root.bottom_bar_height;
            clip: true;
            background: #00000060;
            opacity: root.options_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TapToDismissArea {
                tapped => { root.options_open = false; }
            }

            list_options_sheet := ListOptionsSheet {
                tab: root.active_tab;
                // Leaves a margin (and the status bar) clear on the far side.
                available_height: AppSettings.top_navigation_bar
                    ? parent.height - Math.max(12px, root.safe-area-insets.bottom)
                    : parent.height - Math.max(24px, root.safe-area-insets.top) - 12px;
                // As wide as the bar it's joined to.
                width: parent.width;
                x: 0px;
                side_inset: Math.max(root.safe-area-insets.left, root.safe-area-insets.right);

                // Against the bar; closed, tucked in behind it.
                property <length> open_y: AppSettings.top_navigation_bar ? 0px : parent.height - self.height;
                property <length> slide: AppSettings.top_navigation_bar ? -self.height : self.height;
                from_top: AppSettings.top_navigation_bar;
                attached: true;
                dismiss_requested => { root.options_open = false; }
                y: (root.options_open ? self.open_y : self.open_y + self.slide) + self.drag_offset;
                // Follows the finger while its handle's dragged.
                animate y {
                    duration: self.dragging ? 0ms : 250ms;
                    easing: ease-out-quad;
                }
            }
        }

        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: root.menu_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TouchArea {
                clicked => { root.menu_open = false; }
            }

            Rectangle {
                width: 180px;
                height: menu_layout.preferred-height;

                x: parent.width - self.width - Math.max(16px, root.safe-area-insets.right);
                y: root.menu_open ? Math.max(64px, root.safe-area-insets.top + 48px) : Math.max(48px, root.safe-area-insets.top + 32px);
                animate y {
                    duration: 250ms;
                    easing: ease-out-quad;
                }

                // MD3 Expressive menu: a rounded container, rounded 48 rows
                // with a leading icon, a little apart.
                background: ThemeSettings.surface;
                border-radius: 16px;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000026;

                menu_layout := VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    min-width: 160px;

                    // While selecting (the only time it opens): what doesn't
                    // fit in the header (Cancel, in Stopped), then Select all
                    // and Invert selection.
                    for entry in root.selection_cancel_overflows
                        ? [{ key: 4, label: @tr("Cancel"), icon: @image-url("icons/rounded/cancel.svg") },
                           { key: 2, label: @tr("Select all"), icon: @image-url("icons/rounded/select_all.svg") },
                           { key: 3, label: @tr("Invert selection"), icon: @image-url("icons/rounded/flip.svg") }]
                        : [{ key: 2, label: @tr("Select all"), icon: @image-url("icons/rounded/select_all.svg") },
                           { key: 3, label: @tr("Invert selection"), icon: @image-url("icons/rounded/flip.svg") }]: Rectangle {
                        height: 48px;
                        border-radius: 12px;
                        background: entry_ta.pressed ? ThemeSettings.text_color.transparentize(88%)
                            : entry_ta.has-hover ? ThemeSettings.text_color.transparentize(92%) : transparent;
                        entry_ta := TouchArea {
                            clicked => {
                                root.menu_open = false;
                                if (entry.key == 4) {
                                    root.run_selection_action(SelectionAction.Cancel);
                                } else {
                                    root.select_all(entry.key == 3);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            Image {
                                source: entry.icon;
                                width: 24px;
                                colorize: ThemeSettings.text_color.transparentize(25%);
                                vertical-alignment: center;
                            }
                            Text {
                                text: entry.label;
                                font-size: 14px;
                                font-weight: 500;
                                color: ThemeSettings.text_color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: root.fab_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TapToDismissArea {
                tapped => { root.fab_open = false; }
            }

            Rectangle {
                // As wide as its longest row (the labels stay inside).
                width: fab_layout.preferred-width;
                height: fab_layout.preferred-height;

                x: parent.width - self.width - Math.max(16px, root.safe-area-insets.right);
                y: root.fab_open ? root.height - self.height - root.bottom_bar_height - 80px : root.height - self.height - root.bottom_bar_height - 40px;
                animate y {
                    duration: 250ms;
                    easing: ease-out-quad;
                }

                background: ThemeSettings.surface;
                border-radius: 16px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000020;

                fab_layout := VerticalLayout {
                    padding: 8px;
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: ta_add_link.has-hover ? ThemeSettings.background : transparent;
                        ta_add_link := TouchArea {
                            clicked => {
                                root.fab_open = false;
                                root.add_links_open = true;
                                add_links_sheet.focus_input();
                            }
                        }

                        // MD3 menu item: 12 at the sides, a 24 icon, 12 to the text.
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/rounded/add_link.svg");
                                    width: 24px;
                                    height: 24px;
                                    colorize: ThemeSettings.text_color;
                                }
                            }
                            Text {
                                text: @tr("Add Link(s)");
                                color: ThemeSettings.text_color;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: ta_add_file.has-hover ? ThemeSettings.background : transparent;
                        ta_add_file := TouchArea {
                            clicked => { root.fab_open = false; root.add_from_txt_clicked(); }
                        }

                        // MD3 menu item: 12 at the sides, a 24 icon, 12 to the text.
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/rounded/note_add.svg");
                                    width: 24px;
                                    height: 24px;
                                    colorize: ThemeSettings.text_color;
                                }
                            }
                            Text {
                                text: @tr("Add from file");
                                color: ThemeSettings.text_color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Add links and link preview sheets. Both sit at the bottom, lifted
        // above the on-screen keyboard while it's up.
        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: root.add_links_open || root.preview_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            // Where the sheets' bottom edge goes: above the keyboard, else above
            // the bottom bar (or the gesture area with the top bar).
            property <length> keyboard_top: root.virtual-keyboard-size.height > 0
                ? root.virtual-keyboard-position.y : root.height;
            property <length> sheet_bottom: Math.min(self.keyboard_top - 12px,
                AppSettings.top_navigation_bar ? root.height - Math.max(12px, root.safe-area-insets.bottom)
                : root.height - root.bottom_bar_height - 12px);
            property <length> sheet_width: Math.min(480px, self.width - 2 * Math.max(12px, root.safe-area-insets.left, root.safe-area-insets.right));

            TapToDismissArea {
                tapped => { root.close_sheets(); }
            }

            add_links_sheet := AddLinksSheet {
                text <=> root.add_links_text;
                width: parent.sheet_width;
                x: (parent.width - self.width) / 2;
                y: root.add_links_open ? parent.sheet_bottom - self.height : parent.sheet_bottom - self.height + 24px;
                opacity: root.add_links_open ? 1 : 0;
                // Visible straight away when opening, so the text box can take focus.
                visible: root.add_links_open || self.opacity > 0;
                animate y, opacity { duration: 250ms; easing: ease-out-quad; }

                cancel => { root.close_sheets(); }
                process => {
                    Links.process_text(root.add_links_text, add_links_sheet.spaces);
                    root.add_links_text = "";
                    root.close_sheets();
                }
            }

            if Links.pending.length > 0: LinkPreviewSheet {
                link: Links.pending[0];
                window_width: root.width;
                window_height: root.height;
                position: 1;
                total: Links.pending.length;
                available_height: parent.sheet_bottom - Math.max(24px, root.safe-area-insets.top) - 12px;
                width: parent.sheet_width;
                x: (parent.width - self.width) / 2;
                y: root.preview_open ? parent.sheet_bottom - self.height : parent.sheet_bottom - self.height + 24px;
                opacity: root.preview_open ? 1 : 0;
                visible: self.opacity > 0;
                animate y, opacity { duration: 250ms; easing: ease-out-quad; }

                skip => { Links.skip(self.link.id); }
                download(backend, format, filename, options) => {
                    Links.start(self.link.id, backend, format, filename, options);
                    // Where it shows up.
                    root.options_open = false;
                    root.active_tab = 0;
                }
            }
        }

        // A download's options, at the bottom, lifted above the keyboard while
        // renaming or pasting a link.
        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: root.item_options_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }
            property <length> slide: root.item_options_open ? 0px : 24px;
            animate slide { duration: 250ms; easing: ease-out-quad; }

            property <length> keyboard_top: root.virtual-keyboard-size.height > 0
                ? root.virtual-keyboard-position.y : root.height;
            property <length> sheet_bottom: Math.min(self.keyboard_top - 12px,
                AppSettings.top_navigation_bar ? root.height - Math.max(12px, root.safe-area-insets.bottom)
                : root.height - root.bottom_bar_height - 12px);

            TapToDismissArea {
                tapped => { root.close_item_options(); }
            }

            options_sheet := DownloadOptionsSheet {
                item: root.options_item;
                available_height: parent.sheet_bottom - Math.max(24px, root.safe-area-insets.top) - 12px;
                width: Math.min(480px, parent.width - 2 * Math.max(12px, root.safe-area-insets.left, root.safe-area-insets.right));
                x: (parent.width - self.width) / 2;
                // Only the slide in and the drag animate, not its height (it
                // differs from one download to the next, and animating it
                // made it come in from the wrong side).
                y: parent.sheet_bottom - self.height + parent.slide + self.drag_offset;
                dismiss_requested => { root.close_item_options(); }

                action(action, value) => {
                    root.download_action(root.options_item.id, action, value);
                    root.close_item_options();
                }
                options_changed(options) => {
                    root.download_options_changed(root.options_item.id, options);
                    root.close_item_options();
                }
                delete_requested => {
                    root.close_item_options();
                    root.delete_files = false;
                    root.delete_target = root.options_item.id;
                    root.delete_confirm_open = true;
                }
            }
        }

        // A finished folder download's files (its card tapped).
        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: FolderFiles.open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }
            property <length> slide: FolderFiles.open ? 0px : 24px;
            animate slide { duration: 250ms; easing: ease-out-quad; }

            property <length> sheet_bottom: AppSettings.top_navigation_bar
                ? root.height - Math.max(12px, root.safe-area-insets.bottom)
                : root.height - root.bottom_bar_height - 12px;

            TapToDismissArea {
                tapped => { FolderFiles.open = false; }
            }

            folder_files_sheet := FolderFilesSheet {
                available_height: parent.sheet_bottom - Math.max(24px, root.safe-area-insets.top) - 12px;
                width: Math.min(480px, parent.width - 2 * Math.max(12px, root.safe-area-insets.left, root.safe-area-insets.right));
                x: (parent.width - self.width) / 2;
                // Only the slide in and the drag animate, not its height (a
                // different folder has a different number of files).
                y: parent.sheet_bottom - self.height + parent.slide + self.drag_offset;
                dismiss_requested => { FolderFiles.open = false; }
            }
            // Each opening starts undragged.
            changed visible => {
                if (self.visible) {
                    folder_files_sheet.reset();
                }
            }
        }

        // A download's files to pick again (its options, or its folder's list).
        Rectangle {
            z: 91;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: ChooseFiles.open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }
            property <length> slide: ChooseFiles.open ? 0px : 24px;
            animate slide { duration: 250ms; easing: ease-out-quad; }

            property <length> sheet_bottom: AppSettings.top_navigation_bar
                ? root.height - Math.max(12px, root.safe-area-insets.bottom)
                : root.height - root.bottom_bar_height - 12px;

            TapToDismissArea {
                tapped => { ChooseFiles.open = false; }
            }

            choose_files_sheet := ChooseFilesSheet {
                available_height: parent.sheet_bottom - Math.max(24px, root.safe-area-insets.top) - 12px;
                width: Math.min(480px, parent.width - 2 * Math.max(12px, root.safe-area-insets.left, root.safe-area-insets.right));
                x: (parent.width - self.width) / 2;
                y: parent.sheet_bottom - self.height + parent.slide + self.drag_offset;
                dismiss_requested => { ChooseFiles.open = false; }
            }
            // Each opening starts undragged.
            changed visible => {
                if (self.visible) {
                    choose_files_sheet.reset();
                }
            }
        }

        // Delete confirmation for selected downloads (or one, from its options).
        // One download's details (Info while selecting).
        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: DownloadInfo.open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TapToDismissArea {
                tapped => { DownloadInfo.open = false; }
            }

            DownloadInfoSheet {
                width: Math.min(440px, parent.width - 2 * Math.max(24px, root.safe-area-insets.left, root.safe-area-insets.right));
                available_height: parent.height - 2 * Math.max(48px, root.safe-area-insets.top, root.safe-area-insets.bottom);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + (DownloadInfo.open ? 0px : 24px);
                animate y { duration: 250ms; easing: ease-out-quad; }
                close => { DownloadInfo.open = false; }
            }
        }

        Rectangle {
            z: 90;
            width: 100%;
            height: 100%;
            background: #00000060;
            opacity: root.delete_confirm_open ? 1.0 : 0.0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TapToDismissArea {
                tapped => { root.delete_confirm_open = false; }
            }

            DeleteConfirmSheet {
                count: root.delete_target >= 0 ? 1 : root.selected_count;
                delete_files <=> root.delete_files;
                width: Math.min(400px, parent.width - 2 * Math.max(24px, root.safe-area-insets.left, root.safe-area-insets.right));
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + (root.delete_confirm_open ? 0px : 24px);
                animate y { duration: 250ms; easing: ease-out-quad; }

                cancel => { root.delete_confirm_open = false; }
                confirm => {
                    root.delete_confirm_open = false;
                    if (root.delete_target >= 0) {
                        root.download_action(root.delete_target, ItemAction.Delete, root.delete_files ? "files" : "");
                    } else {
                        root.selection_action(root.active_tab, SelectionAction.Delete, root.delete_files);
                        root.clear_selection();
                    }
                }
            }
        }

        Rectangle {
            z: 100;
            width: 100%;
            height: 100%;
            opacity: root.show_settings ? 1.0 : 0.0;
            y: root.show_settings ? 0px : 40px;
            visible: self.opacity > 0;
            animate opacity, y {
                duration: 250ms;
                easing: ease-out-quad;
            }

            st_page := SettingsPage {
                // Tinted under the phone's cards; desktop's flat rows keep the page's.
                background_color: SettingsLayout.cards ? ThemeSettings.settings_background : ThemeSettings.background;
                text_color: ThemeSettings.text_color;
                accent_color: ThemeSettings.primary_accent;

                is_landscape: root.is_landscape;
                is_mobile_landscape: root.is_mobile_landscape;
                safe_area_top: root.safe-area-insets.top;
                safe_area_left: root.safe-area-insets.left;
                safe_area_right: root.safe-area-insets.right;
                safe_area_bottom: root.safe-area-insets.bottom;
                keyboard_height: root.virtual-keyboard-size.height > 0 ? Math.max(0px, root.height - root.virtual-keyboard-position.y) : 0px;

                back_pressed => { root.show_settings = false; }
                // A tap on a focusable child (e.g. the theme ListView) takes focus;
                // take it back before that child slides off-screen and loses it.
                changed active_tab => { back_scope.focus(); }
            }
        }
    }

    // Eddy's memory and CPU use (Settings → Advanced), over everything; it
    // has no TouchArea, so taps go through to what's under it.
    if AppSettings.show_usage && AppSettings.usage_text != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: Math.max(24px, root.safe-area-insets.top) + 4px;
        width: usage_label.preferred-width + 16px;
        height: usage_label.preferred-height + 8px;
        border-radius: 8px;
        background: #000000a0;
        usage_label := Text {
            text: AppSettings.usage_text;
            font-size: 11px;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Desktop's short messages (Android shows its own toasts).
    if !AppSettings.is_mobile: SnackbarHost {
        width: 100%;
        height: 100%;
        bottom_inset: AppSettings.top_navigation_bar ? 0px : root.bottom_bar_height;
    }

    // Eddy's own folder browser, over everything (see folders.rs).
    if FolderBrowser.open: FolderBrowserSheet {
        width: 100%;
        height: 100%;
        safe_top: root.safe-area-insets.top;
        safe_bottom: root.safe-area-insets.bottom;
        keyboard: root.virtual-keyboard-size.height > 0 ? root.height - root.virtual-keyboard-position.y : 0px;
    }
}
