<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Downloads keep running in a foreground service, with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving downloads by path. Android 11+: anywhere with "All files access"
         (Download/ and Documents/ need nothing). Older: the storage permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Opening Android's installer for the yt-dlp helper apps, when the
         user asks for them in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- yt-dlp comes from YTDLnis's helper apps, if the user installed them
         (Android 11+ hides other apps unless they're listed here). -->
    <queries>
        <package android:name="com.deniscerri.ytdl.python" />
        <package android:name="com.deniscerri.ytdl.ffmpeg" />
        <package android:name="com.deniscerri.ytdl.deno" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Eddy"
        android:resizeableActivity="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:launchMode="singleTask"
            android:exported="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="eddy" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity 
            android:name=".FolderPickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />
        <!-- Lets other apps open downloaded files (content:// links to them). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <activity
            android:name=".FilePickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <!-- Share targets: what another app shares (text, or a .txt / .torrent
             file) reaches one of these three entries in the share sheet. -->
        <activity
            android:name=".ShareActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
        <!-- Runs in its own process: Slint can only start once per process,
             and the main app may already be open. -->
        <activity
            android:name=".SharePopupActivity"
            android:process=":popup"
            android:theme="@style/Theme.Eddy.Popup"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="eddy" />
        </activity>

        <!-- Adds the links in the background, with a toast. -->
        <activity-alias
            android:name=".AddShare"
            android:targetActivity=".ShareActivity"
            android:label="@string/share_add"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity-alias>
        <!-- Popup asking how to download, then starts. -->
        <activity-alias
            android:name=".DownloadShare"
            android:targetActivity=".SharePopupActivity"
            android:label="@string/share_download"
            android:exported="true">
            <!-- GameActivity reads the library name from the alias that
                 launched it, not from SharePopupActivity. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="eddy" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity-alias>
        <!-- Popup previewing each link with its download options. -->
        <activity-alias
            android:name=".PreviewShare"
            android:targetActivity=".SharePopupActivity"
            android:label="@string/share_preview"
            android:exported="true">
            <!-- GameActivity reads the library name from the alias that
                 launched it, not from SharePopupActivity. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="eddy" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
